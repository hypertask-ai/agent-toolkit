#!/usr/bin/env python3
"""Resolve a project identity without printing its token or using host defaults."""

import os
import shlex
import subprocess
import sys

import yaml

from kit_runtime import BOARD_PROJECT, expand, identity, load_config, ticket


def main():
    config, config_path = load_config()
    if sys.argv[1:] == ["--env"]:
        values = {"PROJECT": config["project"]}
        identity(config, config_path)
        ship = config["ship"]
        columns = ship["columns"]
        values.update(TICKET_PREFIXES=" ".join(ship["ticket_prefixes"]),
                      BOARD_ID=ship["board_id"], REPO=ship["repo"],
                      BASE_BRANCH=ship["base_branch"],
                      TICKET_URL_TEMPLATE=ship["ticket_url_template"],
                      COLUMN_AI_REVIEW=columns["handoff"], COLUMN_QA=columns["decision"],
                      COLUMN_IN_PROGRESS=columns["in_progress"],
                      COLUMN_BUGS=columns["claim"], COLUMN_TODO=columns["claim"])
        for key, value in values.items():
            print(f"export KIT_{key}={shlex.quote(str(value))}")
        return 0
    name, path, token_value = identity(config, config_path)
    if not sys.argv[1:]:
        print(f"{name}\t{path}")
        return 0
    args = sys.argv[1:]
    if args[0] != "--board":
        raise ValueError("usage: kit-identity [--env | --board <command> ...]")
    args = args[1:]
    if config["ticket_source"]["type"] != BOARD_PROJECT:
        raise ValueError("kit board operations require the configured board adapter")
    if args[:2] == ["activity", "last"]:
        # Native board CLI has no activity route; existing callers handle exit 4 conservatively.
        return 4
    if len(args) < 2 or args[:2] not in (
            ["sections", "list"], ["tasks", "list"], ["tasks", "get"],
            ["comment", "list"], ["comment", "add"], ["task", "assign"],
            ["task", "unassign"], ["task", "move"]):
        raise ValueError("unsupported kit board operation; refused")
    if args[:2] not in (["sections", "list"], ["tasks", "list"]):
        if len(args) < 3:
            raise ValueError("board operation requires a ticket")
        ticket(config, args[2])
    if args.count("--project") > 1 or args.count("--section") > 1 or any(
            arg.startswith(("--project=", "--section=")) for arg in args):
        raise ValueError("ambiguous board/column overrides are forbidden")
    for index, arg in enumerate(args):
        if arg == "--project" and (index + 1 == len(args) or args[index + 1] != str(config["ship"]["board_id"])):
            raise ValueError("board operation must use the configured board")
    if args[:2] == ["task", "move"]:
        if "--section" not in args or args.index("--section") + 1 == len(args):
            raise ValueError("move requires a configured column")
        column = args[args.index("--section") + 1]
        if column not in config["ship"]["columns"].values():
            raise ValueError("move requires a configured column")
        if column == config["ship"]["columns"].get("done") and not config["ship"].get("done_allowed", False):
            raise ValueError("agents may not move this project's tickets to Done")
    if any(arg in ("--token", "--api-url") or arg.startswith(("--token=", "--api-url=")) for arg in args):
        raise ValueError("board identity and API overrides are forbidden")
    env = dict(os.environ)
    for key in ("HT_TOKEN", "HT_AGENT_TOKEN", "HYPERTASKS_JWT_TOKEN", "HYPERTASK_MANAGEMENT_KEY"):
        env.pop(key, None)
    env["HT_TOKEN"] = token_value
    url = expand(config["ticket_source"]["base_url"])
    if not url.startswith("https://"):
        raise ValueError("board API URL must be HTTPS")
    result = subprocess.run(["hypertask", "--api-url", url, *args], env=env,
                            capture_output=True)
    # Never echo upstream errors that could contain authentication values.
    if result.returncode:
        print("kit-identity: board operation failed (details not echoed)", file=sys.stderr)
    else:
        sys.stdout.buffer.write(result.stdout.replace(token_value.encode(), b"[redacted]"))
    return result.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, UnicodeError, yaml.YAMLError):
        print("kit-identity: config/profile unset, invalid, or token file missing/unreadable; "
              "board writes refused; no Hypertask identity fallback", file=sys.stderr)
        sys.exit(2)
    except ValueError as error:
        print("kit-identity: " + str(error), file=sys.stderr)
        sys.exit(2)
