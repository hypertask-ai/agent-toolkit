#!/usr/bin/env python3
"""Receive signed Hypertask events and run exact-ticket agent ticks."""

from __future__ import annotations

import hashlib
import hmac
import json
import os
import re
import shlex
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any

MAX_BODY = 1024 * 1024
EVENTS = ("comment.created", "comment.mention", "task.assigned")
SLUG_RE = re.compile(r"^[a-z0-9][a-z0-9-]*$")
queue_lock = threading.Lock()
wake = threading.Event()
active: dict[str, int] = {}


def parse_config(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return values
    for raw in lines:
        match = re.match(r"^([A-Z][A-Z0-9_]*)=(.*)$", raw.strip())
        if not match:
            continue
        try:
            parsed = shlex.split(match.group(2), posix=True)
        except ValueError:
            continue
        values[match.group(1)] = parsed[0] if parsed else ""
    return values


def host_config() -> tuple[Path, dict[str, str]]:
    path = Path(os.environ.get(
        "AGENT_TEMPLATE_HOST_CONFIG",
        str(Path.home() / ".config/agent-template/config"),
    ))
    return path, parse_config(path)


def config_dir() -> Path:
    return Path(os.environ.get("AGENT_CONFIG_DIR", str(Path.home() / ".config/hypertask-agents")))


def secret_dir() -> Path:
    return Path(os.environ.get("AGENT_EVENTS_SECRET_DIR", str(Path.home() / ".config/agent-template/webhooks")))


def state_dir() -> Path:
    return Path(os.environ.get("AGENT_EVENTS_STATE_DIR", str(Path.home() / ".local/state/agent-events")))


def agent_rows(events_only: bool = False) -> list[tuple[Path, dict[str, str]]]:
    rows = [(path, parse_config(path)) for path in sorted(config_dir().glob("*.conf"))]
    if events_only:
        rows = [(path, values) for path, values in rows if values.get("WIRING") == "events"]
    return rows


def webhook_host(url: str) -> str:
    try:
        return (urllib.parse.urlsplit(url).hostname or "").casefold()
    except ValueError:
        return ""


def served_webhook_hosts(slug: str, values: dict[str, str]) -> set[str]:
    if values.get("WIRING") != "events":
        return set()
    _, host = host_config()
    urls = [host.get("EVENTS_URL", host.get("WEBHOOK_URL", "")).strip()]
    registration = state_dir() / f"{slug}.registration.json"
    secret = secret_dir() / f"{slug}.secret"
    if registration.is_file() and secret.is_file():
        try:
            saved = json.loads(registration.read_text(encoding="utf-8"))
            if isinstance(saved, dict):
                urls.append(str(saved.get("url") or ""))
        except (OSError, ValueError):
            pass
    return {value for url in urls if (value := webhook_host(url))}


def foreign_webhooks(deactivate: bool = False) -> tuple[list[dict[str, str]], list[str]]:
    violations: list[dict[str, str]] = []
    errors: list[str] = []
    for path, values in agent_rows():
        adapter = values.get("BOARD_ADAPTER", "")
        if adapter and adapter != "hypertask":
            continue
        slug = values.get("AGENT_SLUG") or path.stem
        token_file = Path(values.get("TOKEN_FILE", "")).expanduser()
        if not values.get("AGENT_ID") or not token_file.is_file():
            continue
        try:
            subscription = webhook_subscription(values)
            if not subscription or subscription.get("active") is not True:
                continue
            url = str(subscription.get("url") or "")
            target_host = webhook_host(url)
            if target_host in served_webhook_hosts(slug, values):
                continue
            violation = {"agent": slug, "url": url, "host": target_host or "invalid"}
            violations.append(violation)
            if deactivate:
                api_request(values, {"action": "configure", "agent_id": "self", "active": False})
                print(f"foreign webhook deactivated for {slug}: {violation['host']}")
        except (OSError, ValueError, RuntimeError, urllib.error.URLError, json.JSONDecodeError) as error:
            errors.append(f"{slug}: {error}")
    return violations, errors


def audit_all(json_output: bool = False) -> int:
    violations, errors = foreign_webhooks()
    if json_output:
        print(json.dumps({"foreign_webhooks": violations, "errors": errors}, sort_keys=True))
    else:
        for row in violations:
            print(f"active foreign webhook for {row['agent']}: {row['host']}")
        for error in errors:
            print(f"events audit failed for {error}", file=sys.stderr)
    return 1 if errors else 0


def reconcile_all() -> int:
    _, errors = foreign_webhooks(deactivate=True)
    for error in errors:
        print(f"events reconcile failed for {error}", file=sys.stderr)
    return 1 if errors else 0


def agent_for(agent_id: str) -> tuple[str, dict[str, str], Path] | None:
    for path, values in agent_rows(events_only=True):
        slug = values.get("AGENT_SLUG") or path.stem
        if values.get("AGENT_ID") == agent_id and SLUG_RE.fullmatch(slug):
            return slug, values, secret_dir() / f"{slug}.secret"
    return None


def api_base(values: dict[str, str]) -> str:
    if values.get("BOARD_API_URL"):
        return values["BOARD_API_URL"].rstrip("/")
    try:
        configured = json.loads((Path.home() / ".hypertask/config.json").read_text(encoding="utf-8"))["apiUrl"]
        return str(configured).rstrip("/")
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        return "https://app.hypertask.ai/api"


def api_headers(values: dict[str, str]) -> dict[str, str]:
    token = Path(values["TOKEN_FILE"]).expanduser().read_text(encoding="utf-8").strip()
    return {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
        "User-Agent": "agent-events/1",
    }


def api_request(values: dict[str, str], body: dict[str, Any]) -> dict[str, Any]:
    request = urllib.request.Request(
        api_base(values) + "/mcp/webhooks",
        data=json.dumps(body).encode(), method="POST", headers=api_headers(values),
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        payload = json.load(response)
    if not isinstance(payload, dict) or payload.get("success") is False:
        raise RuntimeError("invalid webhook response")
    return payload


def webhook_subscription(values: dict[str, str]) -> dict[str, Any] | None:
    request = urllib.request.Request(
        api_base(values) + "/mcp/webhooks?agent_id=self",
        headers=api_headers(values),
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        payload = json.load(response)
    if not isinstance(payload, dict) or payload.get("success") is False:
        raise RuntimeError("invalid webhook response")
    subscription = payload.get("subscription")
    return subscription if isinstance(subscription, dict) else None


def cli_prefix() -> list[str] | None:
    for command in (["hypertask", "webhook"], ["hypertask", "agents", "webhook"]):
        try:
            result = subprocess.run(command + ["--help"], stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, timeout=10, check=False)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if result.returncode == 0:
            return command
    return None


def cli_call(values: dict[str, str], action: str, url: str = "") -> dict[str, Any]:
    prefix = cli_prefix()
    if prefix is None:
        raise FileNotFoundError("webhook CLI is unavailable")
    token = Path(values["TOKEN_FILE"]).expanduser().read_text(encoding="utf-8").strip()
    argv = [prefix[0], "--token", token, "--json", *prefix[1:], action]
    if action == "configure":
        argv += ["--url", url, "--enabled"]
        for event in EVENTS:
            argv += ["--event", event]
    result = subprocess.run(argv, text=True, capture_output=True, timeout=30, check=False)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"webhook CLI exited {result.returncode}")
    payload = json.loads(result.stdout)
    if not isinstance(payload, dict):
        raise RuntimeError("webhook CLI did not return an object")
    return payload


def save_registration(slug: str, url: str) -> None:
    directory = state_dir()
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{slug}.registration.json"
    temporary = path.with_suffix(".new")
    temporary.write_text(json.dumps({"url": url, "registeredAt": utc_now()}) + "\n", encoding="utf-8")
    temporary.replace(path)


def register_one(slug: str, url: str) -> int:
    row = next(((p, v) for p, v in agent_rows() if (v.get("AGENT_SLUG") or p.stem) == slug), None)
    if row is None or not SLUG_RE.fullmatch(slug):
        print(f"events register: no current agent named {slug}", file=sys.stderr)
        return 1
    _, values = row
    if values.get("WIRING") != "events":
        print(f"events register: {slug} does not use WIRING=events", file=sys.stderr)
        return 1
    token_file = Path(values.get("TOKEN_FILE", "")).expanduser()
    if not values.get("AGENT_ID") or not token_file.is_file():
        print(f"events register: {slug} has no usable identity token", file=sys.stderr)
        return 1
    secrets = secret_dir()
    secrets.mkdir(parents=True, exist_ok=True, mode=0o700)
    secret_file = secrets / f"{slug}.secret"
    try:
        try:
            result = cli_call(values, "configure", url)
        except (FileNotFoundError, RuntimeError):
            result = api_request(values, {"action": "configure", "agent_id": "self", "url": url,
                                          "events": list(EVENTS), "active": True})
        secret = str(result.get("secret") or "")
        if not secret and not secret_file.is_file():
            try:
                result = cli_call(values, "rotate-secret")
            except (FileNotFoundError, RuntimeError):
                result = api_request(values, {"action": "rotate", "agent_id": "self"})
            secret = str(result.get("secret") or "")
        if secret:
            secret_file.write_text(secret + "\n", encoding="utf-8")
            secret_file.chmod(0o600)
        if not secret_file.is_file():
            raise RuntimeError("the API did not return a signing secret")
        save_registration(slug, url)
        print(f"events configured for {slug}: {url}")
        return 0
    except (OSError, ValueError, RuntimeError, urllib.error.URLError, json.JSONDecodeError) as error:
        print(f"events register failed for {slug}: {error}", file=sys.stderr)
        return 1


def register_all() -> int:
    _, host = host_config()
    url = host.get("EVENTS_URL", host.get("WEBHOOK_URL", "")).strip()
    rows = agent_rows(events_only=True)
    if not url:
        print("no EVENTS_URL or WEBHOOK_URL; receiver is ready and hourly polls remain the path")
        return 0
    failed = 0
    for path, values in rows:
        failed += register_one(values.get("AGENT_SLUG") or path.stem, url)
    return 1 if failed else 0


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def queue_path(slug: str) -> Path:
    return state_dir() / f"{slug}.queue.jsonl"


def handled_path(slug: str) -> Path:
    return state_dir() / f"{slug}.handled"


def handled_deliveries(slug: str) -> set[str]:
    try:
        return set(handled_path(slug).read_text(encoding="utf-8").splitlines())
    except OSError:
        return set()


def mark_handled(slug: str, delivery: str) -> None:
    rows = list(handled_deliveries(slug))
    if delivery:
        rows.append(delivery)
    handled_path(slug).write_text("\n".join(rows[-1000:]) + "\n", encoding="utf-8")


def read_queue(slug: str) -> list[dict[str, Any]]:
    try:
        return [json.loads(line) for line in queue_path(slug).read_text(encoding="utf-8").splitlines() if line.strip()]
    except (OSError, json.JSONDecodeError):
        return []


def write_queue(slug: str, rows: list[dict[str, Any]]) -> None:
    directory = state_dir()
    directory.mkdir(parents=True, exist_ok=True)
    path = queue_path(slug)
    temporary = path.with_suffix(".new")
    temporary.write_text("".join(json.dumps(row) + "\n" for row in rows), encoding="utf-8")
    temporary.replace(path)


def update_status(slug: str, **fields: Any) -> None:
    path = state_dir() / f"{slug}.status.json"
    try:
        current = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        current = {}
    current.update(fields)
    current["queueLength"] = len(read_queue(slug))
    temporary = path.with_suffix(".new")
    temporary.write_text(json.dumps(current) + "\n", encoding="utf-8")
    temporary.replace(path)


def enqueue(slug: str, payload: dict[str, Any]) -> bool:
    with queue_lock:
        rows = read_queue(slug)
        delivery = str(payload.get("deliveryId") or "")
        if delivery in handled_deliveries(slug) or any(str(row.get("deliveryId") or "") == delivery for row in rows):
            return False
        rows.append(payload)
        write_queue(slug, rows)
        update_status(slug, lastEventAt=utc_now(), lastEvent=str(payload.get("event") or ""))
    wake.set()
    return True


def run_one(slug: str, payload: dict[str, Any]) -> None:
    ticket = str(payload.get("ticketNumber") or "")
    runner = os.environ.get("AGENT_BOARD_POLL", "agent-board-poll")
    board = str(payload.get("projectId") or "")
    try:
        result_code = subprocess.run(
            [runner, "--once", "--ticket", ticket, "--board", board, slug], check=False
        ).returncode
    except OSError:
        result_code = 127
    with queue_lock:
        rows = read_queue(slug)
        delivery = str(payload.get("deliveryId") or "")
        for index, row in enumerate(rows):
            if str(row.get("deliveryId") or "") == delivery:
                rows.pop(index)
                break
        write_queue(slug, rows)
        mark_handled(slug, delivery)
        active[slug] = max(0, active.get(slug, 1) - 1)
        update_status(slug, lastRunAt=utc_now(), lastRunTicket=ticket,
                      lastRunExit=result_code)
    wake.set()


def dispatch() -> None:
    while True:
        launched = False
        with queue_lock:
            for path, values in agent_rows(events_only=True):
                slug = values.get("AGENT_SLUG") or path.stem
                try:
                    limit = max(1, int(values.get("MAX_CONCURRENT_RUNS", "1")))
                except ValueError:
                    limit = 1
                rows = read_queue(slug)
                running = active.get(slug, 0)
                # A targeted tick reuses the runner's per-agent lock. Keep one
                # dispatcher active and leave the rest durably queued; this is
                # always within MAX_CONCURRENT_RUNS and cannot drop a lock race.
                if rows and running < min(limit, 1):
                    active[slug] = running + 1
                    threading.Thread(target=run_one, args=(slug, rows[0]), daemon=True).start()
                    launched = True
        if not launched:
            wake.wait(30)
            wake.clear()


def status() -> int:
    found = False
    with queue_lock:
        for path, values in agent_rows(events_only=True):
            found = True
            slug = values.get("AGENT_SLUG") or path.stem
            registration = state_dir() / f"{slug}.registration.json"
            status_path = state_dir() / f"{slug}.status.json"
            try:
                url = str(json.loads(registration.read_text(encoding="utf-8")).get("url") or "not registered")
            except (OSError, json.JSONDecodeError):
                url = "not registered"
            try:
                row = json.loads(status_path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                row = {}
            print(f"{slug}\turl={url}\tlast_event={row.get('lastEventAt') or 'never'}\tqueue={len(read_queue(slug))}")
    if not found:
        print("no WIRING=events agents")
    return 0


class EventHandler(BaseHTTPRequestHandler):
    server_version = "AgentEvents/1"

    def log_message(self, fmt: str, *args: Any) -> None:
        sys.stderr.write("agent-events: " + fmt % args + "\n")

    def reply(self, status_code: int, message: str) -> None:
        body = json.dumps({"status": message}).encode()
        self.send_response(status_code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:  # noqa: N802
        self.reply(200, "ok") if self.path == "/healthz" else self.reply(404, "not found")

    def do_POST(self) -> None:  # noqa: N802
        if self.path != "/webhook/hypertask":
            self.reply(404, "not found")
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        if length <= 0 or length > MAX_BODY:
            self.reply(413, "invalid body length")
            return
        raw = self.rfile.read(length)
        try:
            payload = json.loads(raw)
        except json.JSONDecodeError:
            self.reply(400, "invalid json")
            return
        if not isinstance(payload, dict):
            self.reply(400, "invalid payload")
            return
        event = str(payload.get("event") or "")
        delivery = str(payload.get("deliveryId") or "")
        if event != self.headers.get("X-Hypertask-Event", "") or delivery != self.headers.get("X-Hypertask-Delivery", ""):
            self.reply(400, "header and payload mismatch")
            return
        if event not in EVENTS:
            self.reply(202, "ignored")
            return
        match = agent_for(str(payload.get("agentId") or ""))
        if not match:
            self.reply(403, "wrong agent")
            return
        slug, values, secret_file = match
        timestamp = self.headers.get("X-Hypertask-Timestamp", "")
        signature = self.headers.get("X-Hypertask-Signature", "")
        try:
            secret = secret_file.read_text(encoding="utf-8").strip()
            fresh = abs(time.time() - int(timestamp)) <= 300
        except (OSError, ValueError):
            secret, fresh = "", False
        expected = "sha256=" + hmac.new(secret.encode(), timestamp.encode() + b"." + raw, hashlib.sha256).hexdigest()
        if not fresh or not hmac.compare_digest(signature, expected):
            self.reply(401, "invalid signature")
            return
        boards = {item.strip() for item in values.get("BOARD_ID", "").split(",") if item.strip()}
        if str(payload.get("projectId") or "") not in boards or not payload.get("ticketNumber"):
            self.reply(202, "ignored project")
            return
        if event == "comment.created" and str((payload.get("actor") or {}).get("agentId") or "") == values.get("AGENT_ID"):
            self.reply(202, "ignored own comment")
            return
        queued = enqueue(slug, payload)
        self.reply(202, "queued" if queued else "duplicate")


def serve() -> int:
    state_dir().mkdir(parents=True, exist_ok=True)
    threading.Thread(target=dispatch, daemon=True).start()
    _, host = host_config()
    port = int(os.environ.get("AGENT_EVENTS_PORT", host.get("EVENTS_PORT", "8793")))
    server = ThreadingHTTPServer(("127.0.0.1", port), EventHandler)
    print(f"agent-events listening on 127.0.0.1:{port}", flush=True)
    server.serve_forever()
    return 0


def main() -> int:
    if any(arg in {"-h", "--help"} for arg in sys.argv[1:]):
        print("agent-events [serve|status|register <slug> --url <public-url>|register-all|audit-all [--json]|reconcile-all]")
        return 0
    command = sys.argv[1] if len(sys.argv) > 1 else "serve"
    if command == "serve":
        return serve()
    if command == "status":
        return status()
    if command == "register-all":
        return register_all()
    if command == "audit-all" and len(sys.argv) in (2, 3):
        if len(sys.argv) == 3 and sys.argv[2] != "--json":
            raise SystemExit("usage: agent-events audit-all [--json]")
        return audit_all(json_output=len(sys.argv) == 3)
    if command == "reconcile-all" and len(sys.argv) == 2:
        return reconcile_all()
    if command == "register" and len(sys.argv) == 5 and sys.argv[3] == "--url":
        return register_one(sys.argv[2], sys.argv[4])
    raise SystemExit("usage: agent-events [serve|status|register <slug> --url <public-url>|register-all|audit-all [--json]|reconcile-all]")


if __name__ == "__main__":
    raise SystemExit(main())
