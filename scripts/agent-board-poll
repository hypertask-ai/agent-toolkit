#!/usr/bin/env bash
# agent-board-poll: one tick of a skills-driven agent's work loop.
#
# A tick reads the agent's board through an adapter, finds the tickets that are
# newly addressed to this agent, and starts one short-lived process per ticket.
# Nothing here is specific to a tracker, a vendor or a machine: the board lives
# behind adapters/<name>/adapter.sh, and the model behind a command template in
# the agent's conf.
#
# Usage:
#   agent-board-poll [--once] [--dry-run] [-h|--help] <slug>
#
# One invocation is always one tick, with or without --once. There is no loop
# mode: repetition is the timer's job. --once is accepted only so a hand-run
# reads the same as the unit that calls it.
#
# Examples:
#   agent-board-poll --once --dry-run fp-cro-bot   # what would it pick up?
#   agent-board-poll --once fp-cro-bot             # do it
#
# Failure contract: every error prints "ERROR: <what>. Do this next: <step>"
# on stderr and exits non-zero. Nothing is swallowed.

set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CORE_ROOT="$(dirname "$(dirname "$SELF")")"
# shellcheck disable=SC1091
. "$CORE_ROOT/scripts/lib/core.sh"

usage() {
  sed -n '2,25p' "$SELF" | sed 's/^# \{0,1\}//'
}

DRY_RUN="no"
SLUG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --once) shift ;;   # accepted for readability; every run is one tick
    --dry-run) DRY_RUN="yes"; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option $1" "run agent-board-poll --help for the accepted flags" ;;
    *) [ -z "$SLUG" ] || die "more than one slug given ($SLUG and $1)" \
         "pass exactly one agent slug"; SLUG="$1"; shift ;;
  esac
done
[ -n "$SLUG" ] || die "no agent slug given" \
  "run: agent-board-poll --once --dry-run <slug>"

CONF="$(core_find_conf "$SLUG")" || die \
  "no conf found for agent '$SLUG'" \
  "run create-agent.sh --name \"<Name>\" --wiring poll to create one, or check the slug"
core_read_conf "$CONF"

# ---------- required conf keys ----------
for key in AGENT_ID AGENT_NAME BOARD_ADAPTER BOARD_ID TOKEN_FILE WATCH_SECTIONS \
           SKILLS_INDEX MODEL_CLI BOARD_CLI; do
  eval "value=\${$key:-}"
  [ -n "$value" ] || die "conf $CONF has no $key" \
    "add $key= to that file; see the key list in the create-agent skill"
done
MAX_CONCURRENT_RUNS="${MAX_CONCURRENT_RUNS:-1}"
# An agent may also take tickets nobody has claimed, which is how a board column
# becomes a queue without anyone assigning by hand. Off unless the conf says so,
# because on a shared board it is the difference between helping and barging in.
CLAIM_UNASSIGNED="${CLAIM_UNASSIGNED:-no}"
EXCLUDE_LABELS="${EXCLUDE_LABELS:-}"
# Where the run happens. "repo" runs in AGENT_REPO, the way it always has;
# "per-run" gives each ticket its own checkout and throws it away after.
WORKDIR_MODE="${WORKDIR_MODE:-repo}"
WORKDIR_ROOT="${WORKDIR_ROOT:-}"
case "$WORKDIR_MODE" in
  repo|per-run) : ;;
  *) die "WORKDIR_MODE must be repo or per-run, got '$WORKDIR_MODE'" \
       "fix that key in $CONF" ;;
esac
# A ticket the model CLI cannot finish fails the same way every time. Two goes
# is enough to rule out a flake; a third in the same window is a bug report, not
# a retry.
RETRY_LIMIT="${RETRY_LIMIT:-2}"
RETRY_WINDOW_SECONDS="${RETRY_WINDOW_SECONDS:-21600}"
core_require_abs "$SKILLS_INDEX" "SKILLS_INDEX"
core_require_abs "$TOKEN_FILE" "TOKEN_FILE"
[ -f "$SKILLS_INDEX" ] || die "the skills index $SKILLS_INDEX does not exist" \
  "point SKILLS_INDEX at a real index file; an agent with no skills has nothing to follow"
[ -x "$BOARD_CLI" ] || die "the board CLI $BOARD_CLI is missing or not executable" \
  "re-run create-agent.sh --resume for this agent to reinstall its board wrapper"

core_load_adapter "$BOARD_ADAPTER"
adapter_require_tools

CORE_STATE_NAME="agent-board-poll"
STATE_DIR="$(core_state_dir)"
mkdir -p "$STATE_DIR"
LOG="$STATE_DIR/$SLUG.log"
SEEN="$STATE_DIR/$SLUG.seen"
LOCK="$STATE_DIR/$SLUG.lock"
# The one piece of state a failure needs: when this runner last tried a ticket,
# keyed by ticket id. Without it a ticket whose run dies on start is retried
# every tick forever. It is append-only and self-expiring: nothing reads a line
# older than RETRY_WINDOW_SECONDS.
ATTEMPTS="$STATE_DIR/$SLUG.attempts"
touch "$SEEN" "$ATTEMPTS"

# attempts_recent <task-id> : how many goes this ticket has had in the window
attempts_recent() {
  TASK="$1" WINDOW="$RETRY_WINDOW_SECONDS" python3 -c '
import os, sys, time
task, window = os.environ["TASK"], int(os.environ["WINDOW"])
cutoff, count = time.time() - window, 0
for line in sys.stdin:
    parts = line.split()
    if len(parts) == 2 and parts[0] == task:
        try:
            if float(parts[1]) >= cutoff:
                count += 1
        except ValueError:
            pass
print(count)' < "$ATTEMPTS"
}

log() {
  printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG"
  if [ "$DRY_RUN" = "yes" ]; then printf '%s\n' "$*"; fi
}

# ---------- one tick at a time ----------
# The systemd unit is Type=oneshot, so systemd already refuses a second run
# while one is active. This lock covers hand-runs and any other trigger.
exec 9>"$LOCK"
if ! flock -n 9; then
  log "tick skipped: another tick for $SLUG is still running"
  exit 0
fi

MENTION="$(adapter_mention_token "$AGENT_ID")"
if [ "$DRY_RUN" = "yes" ]; then
  echo "agent $AGENT_NAME ($AGENT_ID) on board $BOARD_ID, sections: $WATCH_SECTIONS"
fi

CANDIDATES="$(adapter_list_candidates "$TOKEN_FILE" "$BOARD_ID" "$WATCH_SECTIONS")"

started=0
picked=0
while IFS= read -r row; do
  [ -n "$row" ] || continue

  task_id="$(ROW="$row" python3 -c 'import json,os;print(json.loads(os.environ["ROW"])["id"])')"
  ref="$(ROW="$row" python3 -c 'import json,os;print(json.loads(os.environ["ROW"])["ref"])')"
  title="$(ROW="$row" python3 -c 'import json,os;print(json.loads(os.environ["ROW"])["title"])')"
  url="$(ROW="$row" python3 -c 'import json,os;print(json.loads(os.environ["ROW"])["url"])')"
  section="$(ROW="$row" python3 -c 'import json,os;print(json.loads(os.environ["ROW"])["section"])')"
  description="$(ROW="$row" python3 -c 'import json,os;print(json.loads(os.environ["ROW"])["description"])')"
  assigned="$(ROW="$row" AID="$AGENT_ID" python3 -c 'import json,os;print("yes" if os.environ["AID"] in json.loads(os.environ["ROW"])["agent_ids"] else "no")')"
  # A ticket is free only if nobody at all is on it and it carries none of the
  # labels this agent is told to stay away from.
  unclaimed="$(ROW="$row" EXCL="$EXCLUDE_LABELS" python3 -c '
import json, os
row = json.loads(os.environ["ROW"])
excluded = {s.strip().casefold() for s in os.environ["EXCL"].split(",") if s.strip()}
labels = set(row.get("labels") or [])
free = row.get("assignee_count", 1) == 0 and not (labels & excluded)
print("yes" if free else "no")')"

  # The newest comment decides two things: whether an @mention addressed this
  # agent, and the state key, so a reply on an old ticket counts as new work.
  comment_json="$(adapter_latest_comment "$TOKEN_FILE" "$task_id" "$BOARD_ID")"
  comment_id=0
  comment_text=""
  mentioned="no"
  if [ -n "$comment_json" ]; then
    comment_id="$(CJ="$comment_json" python3 -c 'import json,os;print(json.loads(os.environ["CJ"]).get("id") or 0)')"
    comment_text="$(CJ="$comment_json" python3 -c '
import html, json, os, re
doc = json.loads(os.environ["CJ"])
print(html.unescape(re.sub(r"<[^>]+>", " ", doc.get("html") or "")).strip()[:1200])')"
    if CJ="$comment_json" M="$MENTION" python3 -c '
import json, os, sys
sys.exit(0 if os.environ["M"] in (json.loads(os.environ["CJ"]).get("html") or "") else 1)'; then
      mentioned="yes"
    fi
  fi

  reason=""
  if [ "$assigned" = "yes" ]; then reason="assigned"; fi
  if [ "$mentioned" = "yes" ]; then reason="${reason:+$reason+}mentioned"; fi
  if [ -z "$reason" ] && [ "$CLAIM_UNASSIGNED" = "yes" ] && [ "$unclaimed" = "yes" ]; then
    reason="unclaimed"
  fi
  [ -n "$reason" ] || continue

  # This agent's own comment is not new work. Without this an agent that
  # finishes and leaves the ticket in a watched column picks it straight back
  # up on the next tick, because its own reply changed the state key. An
  # @mention still wins: that is a human asking for another pass.
  if [ "$reason" = "assigned" ] && [ -n "$comment_json" ]; then
    if CJ="$comment_json" NAME="$AGENT_NAME" python3 -c '
import json, os, sys
author = (json.loads(os.environ["CJ"]).get("author") or "").strip().casefold()
sys.exit(0 if author and author == os.environ["NAME"].strip().casefold() else 1)'; then
      continue
    fi
  fi

  key="$task_id:$comment_id"
  if grep -qxF "$key" "$SEEN"; then
    continue
  fi

  tries="$(attempts_recent "$task_id")"
  if [ "$tries" -ge "$RETRY_LIMIT" ]; then
    log "skipping $ref: $tries attempts already in the last $RETRY_WINDOW_SECONDS seconds"
    continue
  fi
  picked=$((picked + 1))

  if [ "$DRY_RUN" = "yes" ]; then
    echo "would pick up $ref ($reason, section=$section, state key $key, $tries prior attempt(s))"
    echo "    $title"
    echo "    $url"
    continue
  fi

  if [ "$started" -ge "$MAX_CONCURRENT_RUNS" ]; then
    log "hit MAX_CONCURRENT_RUNS=$MAX_CONCURRENT_RUNS, leaving $ref for the next tick"
    break
  fi

  # The board this agent works decides what a ticket's prompt has to say, so
  # its adapter writes it when it has an opinion. Core's version is the one an
  # adapter that does not care still gets.
  if declare -F adapter_run_prompt >/dev/null 2>&1; then
    PROMPT="$(adapter_run_prompt "$SKILLS_INDEX" "$AGENT_NAME" "$BOARD_CLI" \
                "$ref" "$url" "$title" "$description" "$comment_text")"
  else
    PROMPT="Read $SKILLS_INDEX first and follow the skill whose trigger matches this ticket.

Ticket $url: $title.

$description

Latest comment: ${comment_text:-none}

You are $AGENT_NAME. Do the work, then post your reply with
\`$BOARD_CLI comment add $ref --text '<p>your reply in HTML block tags</p>'\`
as this agent, and move the ticket per the skills index. Do not ask for
permission and do not stop halfway: this process exits when you do.

If a human corrects your output at any point, whether they edit your comment,
fail your QA, reject your pull request or simply say that is wrong, stop and
run \`agent-template feedback --what '<one sentence>' --got <the bad output>
--expected '<what should have happened>'\` before you carry on. A correction
that lives only in this run is gone the moment this process exits."
  fi

  RUN_DIR="${AGENT_REPO:-}"
  if [ "$WORKDIR_MODE" = "per-run" ]; then
    RUN_DIR="$(core_workdir_create "${AGENT_REPO:-}" "$WORKDIR_ROOT" "$SLUG-$ref" 2>>"$LOG")" || {
      log "run FAILED $ref: could not make a working directory under $WORKDIR_ROOT"
      printf '%s %s\n' "$task_id" "$(date +%s)" >> "$ATTEMPTS"
      if declare -F adapter_failure_comment >/dev/null 2>&1; then
        adapter_failure_comment "$BOARD_CLI" "$ref" \
          "could not create a working directory under $WORKDIR_ROOT" || true
      fi
      continue
    }
  fi

  ERRFILE="$STATE_DIR/$SLUG.stderr"
  log "run start $ref ($reason) key=$key dir=${RUN_DIR:-.} attempt=$((tries + 1))"
  printf '%s %s\n' "$task_id" "$(date +%s)" >> "$ATTEMPTS"
  started=$((started + 1))
  set +e
  # One short-lived process per ticket. Nothing survives it except the board,
  # the repo, and this log. The agent's token is never in the prompt or the
  # command line: the board CLI wrapper reads it from its own 0600 file.
  read -r -a MODEL_ARGV <<< "$MODEL_CLI"
  (
    # The run happens where the agent's work lives, so the model CLI sees the
    # repo it is meant to change and nothing else.
    if [ -n "$RUN_DIR" ] && [ -d "$RUN_DIR" ]; then cd "$RUN_DIR"; fi
    AGENT_NAME="$AGENT_NAME" AGENT_ID="$AGENT_ID" AGENT_BOARD_CLI="$BOARD_CLI" \
    PATH="$(dirname "$BOARD_CLI"):$PATH" \
      "${MODEL_ARGV[@]}" "$PROMPT"
  ) >> "$LOG" 2>"$ERRFILE"
  rc=$?
  set -e
  cat "$ERRFILE" >> "$LOG" 2>/dev/null || true
  if [ "$WORKDIR_MODE" = "per-run" ]; then
    core_workdir_remove "${AGENT_REPO:-}" "$RUN_DIR" 2>>"$LOG" || true
  fi
  if [ "$rc" -ne 0 ]; then
    # A failure is written where a human already looks. The ticket does not
    # move: where it sits is the record of how far this got. The state key is
    # not recorded either, so the next tick may try once more, up to the
    # attempt budget this ticket has left.
    log "run FAILED $ref exit=$rc: see the lines above in $LOG"
    if declare -F adapter_failure_comment >/dev/null 2>&1; then
      adapter_failure_comment "$BOARD_CLI" "$ref" "$(tail -c 2000 "$ERRFILE" 2>/dev/null)" \
        || log "could not post the failure comment on $ref"
    fi
    printf 'ERROR: the run for %s exited %s. Do this next: read %s, fix the cause; it has %s of %s attempts left in this window\n' \
      "$ref" "$rc" "$LOG" "$((RETRY_LIMIT - tries - 1))" "$RETRY_LIMIT" >&2
  else
    printf '%s\n' "$key" >> "$SEEN"
    log "run done $ref exit=0"
  fi
done <<< "$CANDIDATES"

if [ "$DRY_RUN" = "yes" ]; then
  echo "$picked ticket(s) would be picked up; nothing was started."
else
  log "tick finished: $picked new, $started started"
fi
