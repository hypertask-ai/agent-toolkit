from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))
from ticket_links import format_ticket_links, remove_em_dashes  # noqa: E402

ERROR_REPLY = "I could not answer this, error logged."
MAX_WEBHOOK_BODY = 1024 * 1024
RUNTIME_HEARTBEAT_SECONDS = 30
POLL_CADENCE_SECONDS = 60
TICKET_PATTERN = re.compile(r"\b[A-Z][A-Z0-9]*-\d+\b")


def parse_conf(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8", errors="replace").splitlines():
        match = re.match(r"^([A-Z][A-Z0-9_]*)=(.*)$", raw.strip())
        if not match:
            continue
        try:
            parsed = shlex.split(match.group(2), posix=True)
        except ValueError:
            continue
        values[match.group(1)] = parsed[0] if parsed else ""
    return values


def api_base(values: dict[str, str]) -> str:
    configured = values.get("BOARD_API_URL", "").rstrip("/")
    if configured:
        return configured
    config = Path.home() / ".hypertask/config.json"
    try:
        return str(json.loads(config.read_text())["apiUrl"]).rstrip("/")
    except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
        return "https://app.hypertask.ai/api"


def model_name(command: str) -> str:
    try:
        argv = shlex.split(command)
    except ValueError:
        return "Unreported"
    for index, value in enumerate(argv):
        if value == "--model" and index + 1 < len(argv):
            return argv[index + 1]
        if value.startswith("--model="):
            return value.partition("=")[2]
    return Path(argv[0]).name if argv else "Unreported"


def board_projects(path: Path) -> tuple[int, ...]:
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return ()
    for raw in lines:
        line = raw.split("#", 1)[0].strip()
        key, separator, value = line.partition(":")
        if separator and key in {"project", "board_id"}:
            try:
                return tuple(int(item.strip()) for item in value.strip('"\'').split(",") if item.strip())
            except ValueError:
                return ()
    return ()


def board_sections(path: Path, watch_sections: str) -> tuple[str, ...]:
    configured: list[str] = []
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        lines = []
    in_sections = False
    base_indent = 0
    for raw in lines:
        line = raw.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip())
        stripped = line.strip()
        if indent == 0:
            key = stripped.partition(":")[0]
            in_sections = key in {"roles", "columns", "waiting"}
            base_indent = indent
            if not in_sections:
                continue
        elif not in_sections or indent <= base_indent:
            continue
        value = stripped[2:].strip() if stripped.startswith("- ") else stripped.partition(":")[2].strip()
        value = value.strip('"\'')
        if value and value not in {"[]", "{}"} and not value.isdigit():
            configured.append(value)
    watched = [item.strip() for item in watch_sections.split(",") if item.strip()]
    if watched and watched != ["*"]:
        selected = [item for item in configured if item in watched]
        configured = selected or watched
    return tuple(dict.fromkeys(configured))


@dataclass(frozen=True)
class Agent:
    slug: str
    name: str
    agent_id: str
    mission: str
    repo: str
    token_file: Path
    board_cli: Path
    model_cli: str
    skills: tuple[str, ...]
    api_url: str
    webhook_secret_file: Path | None
    manager: bool = False
    maintainer: bool = False

    @classmethod
    def from_conf(cls, path: Path) -> "Agent | None":
        values = parse_conf(path)
        if values.get("CHAT") != "on":
            return None
        required = ("AGENT_SLUG", "AGENT_NAME", "AGENT_ID", "TOKEN_FILE", "BOARD_CLI", "MODEL_CLI")
        if any(not values.get(key) for key in required):
            return None
        indexes: list[str] = []
        company = Path.home() / "projects/company-skills/INDEX.md"
        stamp = Path.home() / ".config/hypertask-agents/company-pack.version"
        try:
            stamped = stamp.read_text(encoding="utf-8").strip().split(" ", 2)
            if len(stamped) == 3 and Path(stamped[2], "INDEX.md").is_file():
                company = Path(stamped[2], "INDEX.md")
        except OSError:
            pass
        indexes.append(str(company))
        repo = values.get("AGENT_REPO", "")
        if repo and Path(repo, ".claude/skills/INDEX.md").is_file():
            indexes.append(str(Path(repo, ".claude/skills/INDEX.md")))
        indexes.extend(
            item.strip()
            for item in values.get("SKILLS_INDEX", "").split(",")
            if item.strip()
        )
        indexes = list(dict.fromkeys(indexes))
        secret = values.get("CHAT_WEBHOOK_SECRET_FILE", "")
        return cls(
            slug=values["AGENT_SLUG"],
            name=values["AGENT_NAME"],
            agent_id=values["AGENT_ID"],
            mission=values.get("AGENT_MISSION", ""),
            repo=repo,
            token_file=Path(values["TOKEN_FILE"]).expanduser(),
            board_cli=Path(values["BOARD_CLI"]).expanduser(),
            model_cli=values.get("CHAT_CLI") or values["MODEL_CLI"],
            skills=tuple(indexes),
            api_url=api_base(values),
            webhook_secret_file=Path(secret).expanduser() if secret else None,
            manager=values.get("MANAGER") == "on",
            maintainer=values.get("MAINTAINER") == "on",
        )

    def token(self) -> str:
        return self.token_file.read_text(encoding="utf-8").strip()


@dataclass(frozen=True)
class RuntimeAgent:
    slug: str
    token_file: Path
    api_url: str
    board_ids: tuple[int, ...]
    source_sections: tuple[tuple[int, str], ...]
    model: str

    @classmethod
    def from_conf(cls, path: Path) -> "RuntimeAgent | None":
        values = parse_conf(path)
        required = ("AGENT_SLUG", "TOKEN_FILE", "BOARD_ID", "MODEL_CLI")
        if any(not values.get(key) for key in required):
            return None
        try:
            board_ids = tuple(int(item.strip()) for item in values["BOARD_ID"].split(",") if item.strip())
        except ValueError:
            return None
        if not board_ids:
            return None
        sections: list[tuple[int, str]] = []
        for board_id in board_ids:
            specific = path.parent / f"board-{board_id}.yml"
            board_file = specific if specific.is_file() else path.parent / "board.yml"
            described_projects = board_projects(board_file)
            if not specific.is_file() and described_projects and board_id not in described_projects:
                continue
            for section in board_sections(board_file, values.get("WATCH_SECTIONS", "")):
                sections.append((board_id, section))
        return cls(
            slug=values["AGENT_SLUG"],
            token_file=Path(values["TOKEN_FILE"]).expanduser(),
            api_url=api_base(values),
            board_ids=board_ids,
            source_sections=tuple(sections),
            model=model_name(values["MODEL_CLI"]),
        )

    def token(self) -> str:
        return self.token_file.read_text(encoding="utf-8").strip()


class JsonState:
    def __init__(self, path: Path):
        self.path = path
        self.lock = threading.Lock()
        try:
            value = json.loads(path.read_text(encoding="utf-8"))
            self.value = value if isinstance(value, dict) else {}
        except (OSError, ValueError, json.JSONDecodeError):
            self.value = {}

    def save(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        temporary = self.path.with_suffix(self.path.suffix + ".new")
        temporary.write_text(json.dumps(self.value, sort_keys=True) + "\n", encoding="utf-8")
        os.chmod(temporary, 0o600)
        temporary.replace(self.path)


class RuntimeState(JsonState):
    def next_sequence(self, agent: RuntimeAgent) -> tuple[int, str]:
        marker = hashlib.sha256(agent.token().encode()).hexdigest()
        with self.lock:
            row = self.value.get(agent.slug)
            if not isinstance(row, dict) or row.get("credential") != marker:
                row = {"credential": marker, "next": 1}
            sequence = int(row.get("next", 1))
            self.value[agent.slug] = {"credential": marker, "next": sequence + 1}
            self.save()
        return sequence, marker

    def reset(self, agent: RuntimeAgent, marker: str, sequence: int) -> None:
        with self.lock:
            self.value[agent.slug] = {"credential": marker, "next": sequence}
            self.save()


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError, json.JSONDecodeError):
        return {}


def runtime_payload(agent: RuntimeAgent, board_state_dir: Path, sequence: int, version: str) -> dict[str, Any]:
    queue: list[dict[str, Any]] = []
    last_progress_at: str | None = None
    lock = read_json(board_state_dir / f"{agent.slug}.lock")
    ticket = str(lock.get("ticket") or "").upper()
    if TICKET_PATTERN.fullmatch(ticket):
        started_at = str(lock.get("started_at") or "") or None
        queue.append({
            "ticket": ticket,
            "board_id": int(lock.get("board_id") or agent.board_ids[0]),
            "state": "running",
            "reason": "other",
            "started_at": started_at,
        })
        last_progress_at = started_at
    else:
        blocked = read_json(board_state_dir / f"{agent.slug}.blocked")
        blocked_ticket = str(blocked.get("ticket") or "").upper()
        if TICKET_PATTERN.fullmatch(blocked_ticket) and blocked.get("pr"):
            state = str(blocked.get("state") or "red")
            started_at = str(blocked.get("since") or "") or None
            queue.append({
                "ticket": blocked_ticket,
                "board_id": agent.board_ids[0],
                "state": "waiting",
                "reason": f"waiting on PR {blocked['pr']} ({state})",
                "started_at": started_at,
            })
            last_progress_at = started_at

    processed: list[dict[str, Any]] = []
    seen: set[str] = set()
    try:
        lines = (board_state_dir / f"{agent.slug}.log").read_text(
            encoding="utf-8", errors="replace"
        ).splitlines()
    except OSError:
        lines = []
    for line in reversed(lines):
        if "run done " not in line and "run FAILED " not in line:
            continue
        match = TICKET_PATTERN.search(line)
        if not match:
            continue
        ref = match.group(0)
        if last_progress_at is None:
            last_progress_at = line.split(" ", 1)[0]
        if ref not in seen:
            processed.append({"board_id": agent.board_ids[0], "ticket": ref})
            seen.add(ref)
        if len(processed) == 50:
            break

    return {
        "worker_id": agent.slug,
        "sequence": sequence,
        "runtime": f"agent-board-poll {version}",
        "model": agent.model,
        "cadence_seconds": POLL_CADENCE_SECONDS,
        "source_sections": [
            {"board_id": board_id, "section": section}
            for board_id, section in agent.source_sections
        ],
        "processed_tickets": processed,
        "last_progress_at": last_progress_at,
        "queue": queue,
    }


class HandledState:
    def __init__(self, path: Path):
        self.path = path
        self.lock = threading.Lock()
        self.handled: set[str] = set()
        try:
            for line in path.read_text(encoding="utf-8").splitlines():
                row = json.loads(line)
                if row.get("messageId"):
                    self.handled.add(str(row["messageId"]))
        except FileNotFoundError:
            pass

    def contains(self, message_id: str) -> bool:
        with self.lock:
            return message_id in self.handled

    def mark(self, agent: Agent, message_id: str, reply: str) -> None:
        row = {
            "messageId": message_id,
            "agent": agent.slug,
            "handledAt": datetime.now(timezone.utc).isoformat(),
            "replySha256": hashlib.sha256(reply.encode()).hexdigest(),
        }
        with self.lock:
            if message_id in self.handled:
                return
            self.path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            with self.path.open("a", encoding="utf-8") as handle:
                os.chmod(self.path, 0o600)
                handle.write(json.dumps(row, sort_keys=True) + "\n")
                handle.flush()
                os.fsync(handle.fileno())
            self.handled.add(message_id)


class ApiError(RuntimeError):
    def __init__(self, status: int, detail: str):
        super().__init__(f"HTTP {status}: {detail[:500]}")
        self.status = status
        self.detail = detail


class AgentApi:
    def __init__(self, agent: Agent | RuntimeAgent):
        self.agent = agent

    def request(self, method: str, path: str, body: dict[str, Any] | None = None) -> dict[str, Any]:
        data = json.dumps(body).encode() if body is not None else None
        request = urllib.request.Request(
            self.agent.api_url + path,
            data=data,
            method=method,
            headers={
                "Authorization": f"Bearer {self.agent.token()}",
                "Content-Type": "application/json",
                "User-Agent": "agent-chat/1",
            },
        )
        try:
            with urllib.request.urlopen(request, timeout=20) as response:
                payload = json.load(response)
        except urllib.error.HTTPError as error:
            raise ApiError(error.code, error.read().decode(errors="replace")) from error
        if not isinstance(payload, dict) or payload.get("success") is False:
            raise RuntimeError(f"invalid API response: {payload!r}")
        return payload

    def heartbeat(self, body: dict[str, Any]) -> dict[str, Any]:
        try:
            return self.request("POST", "/mcp/agents/runtime-heartbeat", body)
        except ApiError as error:
            if error.status == 409:
                try:
                    payload = json.loads(error.detail)
                except json.JSONDecodeError:
                    pass
                else:
                    if isinstance(payload, dict) and payload.get("reset_sequence"):
                        return payload
            raise

    def pending(self) -> list[dict[str, Any]]:
        payload = self.request("GET", "/mcp/chat/pending")
        rows = payload.get("messages")
        return [row for row in rows if isinstance(row, dict)] if isinstance(rows, list) else []

    def history(self, session_id: str) -> list[dict[str, Any]]:
        quoted = urllib.parse.quote(session_id, safe="")
        payload = self.request("GET", f"/mcp/chat/sessions/{quoted}/messages")
        rows = payload.get("messages")
        return [row for row in rows if isinstance(row, dict)] if isinstance(rows, list) else []

    def ticket(self, reference: str) -> dict[str, Any]:
        quoted = urllib.parse.urlencode({"ticket_number": reference})
        return self.request("GET", f"/mcp/tasks?{quoted}")

    def reply(self, session_id: str, message_id: str, text: str) -> None:
        quoted = urllib.parse.quote(session_id, safe="")
        self.request(
            "POST",
            f"/mcp/chat/sessions/{quoted}/messages",
            {"text": text[:8000], "replyToMessageId": message_id},
        )


def recent_work(slug: str) -> str:
    path = Path.home() / ".local/state/agent-board-poll" / f"{slug}.log"
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return "No recent ticket run log is available."
    useful = [line for line in lines if "run start " in line or "run done " in line or "run FAILED " in line]
    return "\n".join(useful[-8:]) or "No recent ticket run is recorded."


def shape_command_reply(reply: str, message_text: str) -> str:
    reference = TICKET_PATTERN.search(message_text)
    failure = re.search(r"(?:^|\n)(feedback|ctl|delegate)\s+(?:refused|failed):", reply)
    if failure:
        command = failure.group(1)
        if command == "feedback":
            return "The feedback ticket could not be filed."
        if command == "delegate" and reference:
            return f"{reference.group(0)} could not be delegated."
        if command == "delegate":
            return "The delegation could not be completed."
        return "The requested ticket runner action could not be completed."

    filed = re.search(r"(?:^|\n)filed\s+([A-Z][A-Z0-9]*-\d+)\b", reply, re.IGNORECASE)
    if filed:
        return f"Feedback was filed as {filed.group(1).upper()}."

    control = re.search(r"(?:^|\n)ctl\s+(start|stop|status)\s+([a-z0-9-]+):([^\n]*)", reply)
    if control:
        action, target, detail = control.groups()
        name = target.replace("-", " ")
        if action == "start":
            return f"The ticket runner for {name} was started."
        if action == "stop":
            return f"The ticket runner and current job for {name} were stopped."
        timer = re.search(r"timer=([^\s]+)", detail)
        service = re.search(r"service=([^\s]+)", detail)
        timer_state = timer.group(1) if timer else "unknown"
        service_state = service.group(1) if service else "unknown"
        return f"The ticket runner for {name} is {timer_state}, and its current job is {service_state}."

    handoff = re.search(r"(?:^|\n)Handed to (.+?) by [^:\n]+:", reply)
    if handoff and reference:
        return f"{reference.group(0)} was delegated to {handoff.group(1).strip()}."
    return reply


def finalize_chat_reply(
    reply: str,
    message_text: str,
    lookup: Any,
) -> str:
    shaped = shape_command_reply(reply, message_text)
    return format_ticket_links(remove_em_dashes(shaped), "chat", lookup)


def prompt_for(agent: Agent, message: dict[str, Any], history: list[dict[str, Any]]) -> str:
    transcript = "\n".join(
        f"{row.get('role', 'unknown')}: {str(row.get('content', ''))[:4000]}"
        for row in history[-50:]
    ) or "(no earlier messages)"
    indexes = "\n".join(f"- {path}" for path in agent.skills) or "- none configured"
    manager_brief = ""
    board_rule = "- Never post a ticket comment or make any board write."
    external_rule = "- Do not change files, accounts, connectors, code, or any external system."
    if agent.manager or agent.maintainer:
        board_rule = "- Never post a ticket comment or make any board write except through the delegate and feedback commands listed below."
        external_rule = "- Do not change files, accounts, connectors, code, or any external system except through the manager commands listed below."
        manager_brief = f"""
Manager commands available in this chat:
- `agent-template ctl start|stop|status <slug>`. Example: "stop dev 1" runs `agent-template ctl stop dev-1`.
- `agent-template delegate <ticket> <slug> --why "<one line reason>"`. Example: "give HTPR-6550 to dev 2" runs `agent-template delegate HTPR-6550 dev-2 --why "Take the implementation"`.
- `agent-template mode manual|auto [--board <id>]`. Example: "switch the product board to manual" runs `agent-template mode manual`.
- `agent-template model <slug> <preset>`. Presets are `grok-fast`, `glm-flash`, and `codex-sol`. Example: "put dev 2 on grok fast" runs `agent-template model dev-2 grok-fast`.
- `agent-template quiet on|off [<slug>|all]`. Example: "quiet off for qa-1" runs `agent-template quiet off qa-1`.
- `agent-template feedback --as <slug> --kind bug|change|idea --what "<summary>" --got "<current behavior or context>" --expected "<desired behavior>"`. Example: "file a toolkit ticket: add a setup report" runs `agent-template feedback --as {agent.slug} --kind idea --what "Add a setup report" --got "No setup report exists" --expected "Provide a setup report"`.
These commands never change token files, credentials, foreign units, files outside the conf dir, or legacy confs without `BOARD_ADAPTER`. These are the only external changes allowed in chat. After a command, return one plain sentence describing its outcome. Include the affected ticket as a Markdown link with its full id and title when the command concerns a ticket. Never paste raw command output.
"""
    if agent.maintainer:
        external_rule = "- Make setup changes only through the allowlisted maintainer commands below. Never edit a shared checkout or run hax or codex directly."
        manager_brief += f"""
Setup maintainer contract:
- You execute setup changes. The chat and advisor only supply instructions.
- For every change to the agent toolkit, supervisor rules, analytics site, app, CLI, or Slack bot, write a spec with Ticket, What, Done when, and Guardrails, then run `agent-template build --repo <key> --ticket <url> --spec <file|-> [--effort high|xhigh]`.
- Inspect work with `agent-template build status [id]` and `agent-template build list`. Answer "what did you do" from that record.
- Merge an existing allowlisted pull request only with `agent-template merge <pr-url>`.
- After a toolkit build merges, deploy it with `agent-template update --keep-timers`.
- Never launch a model harness directly. Never work around the repository allowlist.
After a maintainer command, return one plain outcome sentence and never paste raw command output. Include any affected ticket as a Markdown link with its full id and title.
"""
    return f"""You are {agent.name}. This is a live Hypertask Agent Chat conversation, not ticket work.

Mission:
{agent.mission or '(no mission configured)'}

Hard lane boundary:
- Reply to the user in chat only.
{board_rule}
- Never inspect, create, or edit a repository worktree.
{external_rule}
- If the user asks for any other change, explain what should be done and that it needs ticket work.
{manager_brief}
Read the applicable skills from these index paths in order, company pack first:
{indexes}

Short work brief from this host:
Who I am: {agent.name} ({agent.slug}).
What I am working on, from the latest ticket-run log:
{recent_work(agent.slug)}

Conversation history, oldest first:
{transcript}

New message from {message.get('userName') or 'the user'}:
{str(message.get('text') or '')[:8000]}

Return only the concise reply that should appear in Agent Chat. Do not include tool traces or preamble. Use `[TICKET-ID Ticket title](https://app.hypertask.ai/detail/project-N/ID)` for every ticket reference. Do not use em dashes."""


def agent_process_env(agent: Agent) -> dict[str, str]:
    environment = dict(os.environ)
    original_path = environment.get("PATH", "")
    environment["AGENT_ORIGINAL_PATH"] = original_path
    prepared = subprocess.run(
        [str(Path(__file__).resolve().with_name("agent-identity-shim")), agent.slug,
         str(agent.token_file), str(agent.board_cli)],
        env=environment,
        text=True,
        capture_output=True,
        check=False,
    )
    if prepared.returncode != 0:
        raise RuntimeError(prepared.stderr.strip() or f"identity shim failed for {agent.slug}")
    shim_dir = prepared.stdout.strip()
    environment.update({
        "AGENT_NAME": agent.name,
        "AGENT_ID": agent.agent_id,
        "AGENT_SLUG": agent.slug,
        "HYPERTASK_TOKEN_FILE": str(agent.token_file),
        "PATH": f"{shim_dir}:{original_path}",
    })
    return environment


def run_provider(agent: Agent, prompt: str, timeout: int = 90) -> str:
    argv = shlex.split(agent.model_cli)
    if not argv:
        raise RuntimeError("MODEL_CLI is empty")
    scratch = Path(os.environ.get("AGENT_CHAT_STATE_DIR", str(Path.home() / ".local/state/agent-chat"))) / "scratch" / agent.slug
    scratch.mkdir(parents=True, exist_ok=True, mode=0o700)
    result = subprocess.run(
        [*argv, prompt],
        cwd=scratch,
        env=agent_process_env(agent),
        text=True,
        capture_output=True,
        timeout=timeout,
        check=False,
    )
    if result.returncode != 0:
        raise RuntimeError(f"provider exited {result.returncode}: {result.stderr[-1000:]}")
    reply = result.stdout.strip()
    if not reply:
        raise RuntimeError("provider returned an empty reply")
    return reply[:8000]


class ChatDaemon:
    def __init__(
        self,
        config_dir: Path,
        state_dir: Path,
        workers: int = 16,
        board_state_dir: Path | None = None,
    ):
        self.config_dir = config_dir
        self.state_dir = state_dir
        self.board_state_dir = board_state_dir or Path.home() / ".local/state/agent-board-poll"
        self.state = HandledState(state_dir / "handled.jsonl")
        self.runtime_state = RuntimeState(state_dir / "runtime-sequences.json")
        self.runtime_status = JsonState(state_dir / "runtime-status.json")
        try:
            self.version = (Path(__file__).resolve().parents[1] / "VERSION").read_text().strip()
        except OSError:
            self.version = "unknown"
        self.executor = ThreadPoolExecutor(max_workers=workers, thread_name_prefix="agent-chat")
        self.inflight: set[str] = set()
        self.inflight_lock = threading.Lock()
        self.stop = threading.Event()

    def log(self, agent: Agent | RuntimeAgent, text: str) -> None:
        self.state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
        line = f"{datetime.now(timezone.utc).isoformat()} {text}\n"
        with (self.state_dir / f"{agent.slug}.log").open("a", encoding="utf-8") as handle:
            handle.write(line)

    def agents(self) -> list[Agent]:
        agents: list[Agent] = []
        for path in sorted(self.config_dir.glob("*.conf")):
            try:
                agent = Agent.from_conf(path)
                if agent:
                    agents.append(agent)
            except Exception as error:
                fallback = path.stem
                self.state_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
                with (self.state_dir / f"{fallback}.log").open("a", encoding="utf-8") as handle:
                    handle.write(f"{datetime.now(timezone.utc).isoformat()} config error: {error}\n")
        return agents

    def runtime_agents(self) -> list[RuntimeAgent]:
        agents: list[RuntimeAgent] = []
        for path in sorted(self.config_dir.glob("*.conf")):
            try:
                agent = RuntimeAgent.from_conf(path)
                if agent:
                    agents.append(agent)
            except Exception as error:
                fallback = RuntimeAgent(
                    slug=path.stem,
                    token_file=Path("/missing"),
                    api_url="",
                    board_ids=(0,),
                    source_sections=(),
                    model="Unreported",
                )
                self.log(fallback, f"runtime config error: {type(error).__name__}: {error}")
        return agents

    def handle(self, agent: Agent, message: dict[str, Any], api: AgentApi | None = None) -> None:
        message_id = str(message.get("id") or message.get("messageId") or "")
        session_id = str(message.get("sessionId") or "")
        if not message_id or not session_id or self.state.contains(message_id):
            return
        client = api or AgentApi(agent)
        try:
            history = client.history(session_id)
            reply = run_provider(agent, prompt_for(agent, message, history))
            reply = finalize_chat_reply(
                reply,
                str(message.get("text") or ""),
                lambda reference: client.ticket(reference),
            )
        except Exception as error:
            self.log(agent, f"message {message_id} provider error: {type(error).__name__}: {error}")
            reply = ERROR_REPLY
        try:
            client.reply(session_id, message_id, reply)
        except ApiError as error:
            if error.status == 409:
                self.state.mark(agent, message_id, reply)
                self.log(agent, f"message {message_id} was already terminal")
                return
            self.log(agent, f"message {message_id} reply error: {error}")
            return
        except Exception as error:
            self.log(agent, f"message {message_id} reply error: {type(error).__name__}: {error}")
            return
        self.state.mark(agent, message_id, reply)
        self.log(agent, f"handled message {message_id}; reply={json.dumps(reply, ensure_ascii=False)}")

    def submit(self, agent: Agent, message: dict[str, Any]) -> None:
        message_id = str(message.get("id") or message.get("messageId") or "")
        if not message_id or self.state.contains(message_id):
            return
        with self.inflight_lock:
            if message_id in self.inflight:
                return
            self.inflight.add(message_id)
        future = self.executor.submit(self.handle, agent, message)
        future.add_done_callback(lambda _future: self._finished(message_id))

    def _finished(self, message_id: str) -> None:
        with self.inflight_lock:
            self.inflight.discard(message_id)

    def record_runtime_status(self, agent: RuntimeAgent, result: str, detail: str = "") -> None:
        with self.runtime_status.lock:
            self.runtime_status.value[agent.slug] = {
                "at": datetime.now(timezone.utc).isoformat(),
                "result": result,
                "detail": detail[:500],
                "runtime": f"agent-board-poll {self.version}",
            }
            self.runtime_status.save()

    def heartbeat_once(self, api_factory: Any = AgentApi) -> None:
        for agent in self.runtime_agents():
            try:
                sequence, marker = self.runtime_state.next_sequence(agent)
                body = runtime_payload(agent, self.board_state_dir, sequence, self.version)
                response = api_factory(agent).heartbeat(body)
                reset_sequence = response.get("reset_sequence")
                if isinstance(reset_sequence, int) and reset_sequence > 0:
                    self.runtime_state.reset(agent, marker, reset_sequence)
                    self.record_runtime_status(agent, "resync", f"next sequence {reset_sequence}")
                else:
                    self.record_runtime_status(agent, "ok")
            except Exception as error:
                detail = f"{type(error).__name__}: {error}"
                self.record_runtime_status(agent, "error", detail)
                self.log(agent, f"runtime heartbeat error: {detail}")

    def heartbeat_loop(self, interval: float = RUNTIME_HEARTBEAT_SECONDS) -> None:
        while not self.stop.is_set():
            self.heartbeat_once()
            self.stop.wait(interval)

    def poll_once(self) -> None:
        for agent in self.agents():
            try:
                for message in AgentApi(agent).pending():
                    self.submit(agent, message)
            except Exception as error:
                self.log(agent, f"poll error: {type(error).__name__}: {error}")

    def serve(self, interval: float) -> None:
        while not self.stop.is_set():
            self.poll_once()
            self.stop.wait(interval)
        self.executor.shutdown(wait=True)


class WebhookHandler(BaseHTTPRequestHandler):
    server_version = "AgentChatWebhook/1"

    def log_message(self, _format: str, *_args: Any) -> None:
        return

    def send_json(self, status: int, message: str) -> None:
        body = json.dumps({"status": message}).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:  # noqa: N802
        self.send_json(200, "ok") if self.path == "/healthz" else self.send_json(404, "not found")

    def do_POST(self) -> None:  # noqa: N802
        daemon: ChatDaemon = self.server.daemon_ref  # type: ignore[attr-defined]
        if self.path != "/webhook/hypertask":
            self.send_json(404, "not found")
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = 0
        if length <= 0 or length > MAX_WEBHOOK_BODY:
            self.send_json(413, "invalid body length")
            return
        raw = self.rfile.read(length)
        try:
            payload = json.loads(raw)
        except json.JSONDecodeError:
            self.send_json(400, "invalid json")
            return
        agent = next((item for item in daemon.agents() if item.agent_id == payload.get("agentId")), None)
        if not agent or not agent.webhook_secret_file:
            self.send_json(403, "wrong agent")
            return
        timestamp = self.headers.get("X-Hypertask-Timestamp", "")
        delivery = self.headers.get("X-Hypertask-Delivery", "")
        event = self.headers.get("X-Hypertask-Event", "")
        signature = self.headers.get("X-Hypertask-Signature", "")
        try:
            secret = agent.webhook_secret_file.read_text(encoding="utf-8").strip()
            fresh = abs(time.time() - int(timestamp)) <= 300
        except (OSError, ValueError):
            fresh = False
            secret = ""
        expected = "sha256=" + hmac.new(secret.encode(), timestamp.encode() + b"." + raw, hashlib.sha256).hexdigest()
        if not fresh or not hmac.compare_digest(signature, expected):
            self.send_json(401, "invalid signature")
            return
        if payload.get("deliveryId") != delivery or payload.get("event") != event:
            self.send_json(400, "header and payload mismatch")
            return
        if event == "chat.message" and isinstance(payload.get("chat"), dict):
            chat = payload["chat"]
            daemon.submit(agent, {
                "id": chat.get("messageId"),
                "sessionId": chat.get("sessionId"),
                "text": chat.get("text"),
                "userName": chat.get("userName"),
            })
        self.send_json(202, "accepted")


def show_status(config_dir: Path, state_dir: Path) -> int:
    status = read_json(state_dir / "runtime-status.json")
    shown = 0
    for path in sorted(config_dir.glob("*.conf")):
        agent = RuntimeAgent.from_conf(path)
        if not agent:
            continue
        row = status.get(agent.slug)
        row = row if isinstance(row, dict) else {}
        print(
            f"{agent.slug}\t{row.get('result', 'never')}\t"
            f"{row.get('at', 'never')}\t{row.get('runtime', 'agent-board-poll unknown')}"
        )
        shown += 1
    return 0 if shown else 1


def main() -> int:
    if any(arg in {"-h", "--help"} for arg in sys.argv[1:]):
        print("agent-chat: answer Agent Chat and publish runtime heartbeats for this host")
        print("usage: agent-chat [--status]")
        return 0
    config_dir = Path(os.environ.get("AGENT_CHAT_CONFIG_DIR", str(Path.home() / ".config/hypertask-agents")))
    state_dir = Path(os.environ.get("AGENT_CHAT_STATE_DIR", str(Path.home() / ".local/state/agent-chat")))
    if sys.argv[1:] == ["--status"]:
        return show_status(config_dir, state_dir)
    if sys.argv[1:]:
        raise SystemExit(f"unknown option: {sys.argv[1]}")
    interval = float(os.environ.get("AGENT_CHAT_POLL_SECONDS", "3"))
    heartbeat_interval = float(os.environ.get("AGENT_RUNTIME_HEARTBEAT_SECONDS", str(RUNTIME_HEARTBEAT_SECONDS)))
    if interval <= 0:
        raise SystemExit("AGENT_CHAT_POLL_SECONDS must be greater than zero")
    if heartbeat_interval <= 0:
        raise SystemExit("AGENT_RUNTIME_HEARTBEAT_SECONDS must be greater than zero")
    board_state_dir = Path(os.environ.get(
        "AGENT_BOARD_STATE_DIR", str(Path.home() / ".local/state/agent-board-poll")
    ))
    daemon = ChatDaemon(config_dir, state_dir, board_state_dir=board_state_dir)
    signal.signal(signal.SIGTERM, lambda *_args: daemon.stop.set())
    signal.signal(signal.SIGINT, lambda *_args: daemon.stop.set())
    port = int(os.environ.get("AGENT_CHAT_WEBHOOK_PORT", "0"))
    server = None
    heartbeat_thread = threading.Thread(
        target=daemon.heartbeat_loop,
        args=(heartbeat_interval,),
        daemon=True,
        name="agent-runtime-heartbeat",
    )
    heartbeat_thread.start()
    if port:
        server = ThreadingHTTPServer(("127.0.0.1", port), WebhookHandler)
        server.daemon_ref = daemon  # type: ignore[attr-defined]
        threading.Thread(target=server.serve_forever, daemon=True, name="agent-chat-webhook").start()
    try:
        daemon.serve(interval)
    finally:
        daemon.stop.set()
        heartbeat_thread.join(timeout=5)
        if server:
            server.shutdown()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
