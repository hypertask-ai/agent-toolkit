#!/usr/bin/env bash
# agent-template: the template talking about itself.
#
# Three subcommands today:
#
#   agent-template feedback --kind bug|change|idea \
#       --what "<summary>" --got "<current behavior or context>" \
#       --expected "<desired behavior>" \
#       [--adapter hypertask|linear|none] [--agent <slug>] \
#       [--dry-run] [--opt-out] [--case --check '<predicate> ["<arg>"]']
#
#   agent-template report [--days N]
#
#   agent-template update [--dry-run] [--no-host-notes]
#
# update is how a bot host stays current without a human explaining the fix
# to it: pull the template repo, reinstall, and bring every conf that is
# still on the old HT_* fleet schema forward onto the current one, so a bot
# host nobody is watching does not silently drift. Steps:
#   1. git pull --ff-only in AGENT_TEMPLATE_REPO (default ~/projects/vstack)
#   2. run install.sh, which also refreshes the shared systemd units, clones
#      or fast-forwards the shared company skills pack to
#      ~/projects/company-skills, and runs the eval suite; either failing
#      stops here, non-zero, and nothing below runs
#   2c. print where the company pack landed and what commit it is on, so a
#       daily run says out loud whether every bot on this host is reading
#       the current shared rules
#   2b. print every CHANGELOG.md line marked ACTION: (something this
#       template cannot do for itself) and log each one once per version to
#       ~/.local/state/agent-template/actions.log, so a maintainer session
#       has one place to read pending actions from
#   3. for every *.conf in AGENT_CONFIG_DIR (default
#      ~/.config/hypertask-agents) written in the old HT_* schema
#      (HT_AGENT_ID / HT_MODEL / HT_MISSION / HT_START_SECTIONS), with no
#      template conf for that slug already: append the template-schema keys
#      (AGENT_ID, TOKEN_FILE, BOARD_ADAPTER=hypertask, BOARD_ID,
#      WATCH_SECTIONS, SKILLS_INDEX, MODEL_CLI, MAX_CONCURRENT_RUNS) to the
#      SAME file, backed up first as <slug>.conf.bak-<epoch>. A converted
#      conf is a draft: TOKEN_FILE and BOARD_CLI do not exist yet, so no
#      timer is created or started for it. Skipped, not converted, when:
#      the slug's old worker unit (hypertask-agent-worker@<slug>) is
#      masked (retired); the file already has BOARD_ADAPTER= (already has
#      a template twin); or HT_PROVIDER has no known MODEL_CLI mapping
#      (cursor, codex, claude and pi are known). Models are copied as data;
#      this compatibility conversion does not enforce a provider policy.
#   4. removes now-redundant agent-board-poll@<slug>.service.d/path.conf
#      drop-ins (backed up first) now that the shared unit sets PATH
#      itself, then systemctl --user daemon-reload, and restarts (never
#      more than that -- never enables, never starts a fresh timer) only
#      the timers that were already enabled and whose unit config actually
#      changed this run.
# --dry-run prints what step 3 and 4 would do and changes nothing.
#
# Run feedback the moment a human corrects your output. It files the
# correction on the feedback board so it can become a replayable check,
# instead of dying in a chat window nobody reads again.
#
#   --what      one sentence: what went wrong
#   --got       the bad output: a file path, or the text itself
#   --expected  what should have happened
#   --adapter   which adapter was in play          (default: from the conf)
#   --kind      bug, change or idea                         (default: bug)
#   --agent     agent slug, if the conf cannot be found from the environment
#   --dry-run   print the ticket body, send nothing
#   --opt-out   this run sends nothing (the conf key FEEDBACK_OPT_OUT=yes
#               turns sending off for every run)
#   --case      also propose this as a replayable eval case, appended to
#               evals/proposed.jsonl in the AGENT_TEMPLATE_REPO checkout
#               (default ~/projects/vstack) for the accepted fix to use.
#               Needs --check.
#   --check     a predicate name from the allowlist in evals/run-evals.sh
#               (starts_with_block_tag, has_section "<title>",
#               is_full_https_url), with its argument if it takes one.
#
# report prints how many corrections were filed in the last N days (default
# 7) and how many of those were repeats of something already known, from the
# local log every feedback call appends to.
#
# Failure contract: ERROR: <what happened>. Do this next: <one step>, non-zero.

set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
# The update re-exec below runs this script from a throwaway copy in
# /tmp so it survives install.sh overwriting the original mid-run. That
# copy's own dirname is not CORE_ROOT, so the parent passes the real one
# through instead of letting the child recompute a wrong one.
CORE_ROOT="${AGENT_TEMPLATE_CORE_ROOT:-$(dirname "$(dirname "$SELF")")}"
# shellcheck disable=SC1091
. "$CORE_ROOT/scripts/lib/core.sh"
# shellcheck disable=SC1091
. "$CORE_ROOT/scripts/lib/feedback.sh"

# Where corrections land. Overridable so a fork can point at its own board
# without editing this file.
FEEDBACK_BOARD_ID="${FEEDBACK_BOARD_ID:-5500}"
FEEDBACK_BOARD_SECTION="${FEEDBACK_BOARD_SECTION:-Inbox}"
FEEDBACK_BOARD_URL="${FEEDBACK_BOARD_URL:-https://app.hypertask.ai/detail/project-5500}"

usage() { sed -n '2,76p' "$SELF" | sed 's/^# \{0,1\}//'; }
feedback_usage() {
  cat <<EOF
agent-template feedback --kind bug|change|idea --what "<summary>" --got "<current behavior or context>" --expected "<desired behavior>" [options]

Files feedback in the Agent Template Inbox as the agent's own bot identity.
Board: $FEEDBACK_BOARD_URL

Example:
  agent-template feedback --kind bug --what "Update hid the feedback board" --got "No feedback hint" --expected "Print the board URL"

Options: --adapter hypertask|linear|none, --agent <slug>, --dry-run,
         --opt-out, --case --check '<predicate> ["<arg>"]'
EOF
}

# Every feedback call, sent or not, leaves one line here: the local record
# `report` reads. State, not a board write, so it needs no credentials.
FEEDBACK_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-template"
FEEDBACK_LOG="$FEEDBACK_LOG_DIR/feedback.jsonl"

# update replaces this very file via install.sh partway through its own run
# (install.sh cp -a's over $SELF). A shell mid-read of a file that gets
# truncated under it fails with a bogus syntax error, not our error message.
# So the first thing an update run does is re-exec itself from a private
# copy that install.sh cannot touch, before anything else happens.
if [ "${1:-}" = "update" ] && [ -z "${AGENT_TEMPLATE_UPDATE_REEXEC:-}" ]; then
  REEXEC_COPY="$(mktemp "${TMPDIR:-/tmp}/agent-template-update.XXXXXX")"
  cp "$SELF" "$REEXEC_COPY"
  chmod +x "$REEXEC_COPY"
  export AGENT_TEMPLATE_UPDATE_REEXEC="$REEXEC_COPY"
  export AGENT_TEMPLATE_CORE_ROOT="$CORE_ROOT"
  exec "$REEXEC_COPY" "$@"
fi

# ---------- subcommand ----------
[ $# -gt 0 ] || { usage; exit 0; }
case "$1" in
  -h|--help|help) usage; exit 0 ;;
  version) cat "$CORE_ROOT/VERSION"; exit 0 ;;
  feedback) shift ;;
  report) shift; SUBCOMMAND="report" ;;
  update) shift; SUBCOMMAND="update" ;;
  *) die "unknown subcommand $1" "run agent-template --help" ;;
esac

if [ "${SUBCOMMAND:-feedback}" = "report" ]; then
  DAYS=7
  while [ $# -gt 0 ]; do
    case "$1" in
      --days) DAYS="${2:?--days needs a number}"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option $1" "run agent-template report --help" ;;
    esac
  done
  [ -f "$FEEDBACK_LOG" ] || { echo "no corrections logged yet at $FEEDBACK_LOG"; exit 0; }
  DAYS="$DAYS" python3 -c '
import datetime, json, os, sys
cutoff = datetime.datetime.now(datetime.timezone.utc) - datetime.timedelta(days=int(os.environ["DAYS"]))
total, repeats, rows = 0, 0, []
with open(sys.argv[1], encoding="utf-8") as fh:
    for line in fh:
        line = line.strip()
        if not line:
            continue
        row = json.loads(line)
        when = datetime.datetime.fromisoformat(row["date"])
        if when < cutoff:
            continue
        total += 1
        if row.get("repeated"):
            repeats += 1
        rows.append(row)
print("=== corrections, last %s day(s) ===" % os.environ["DAYS"])
print("%d filed, %d repeated" % (total, repeats))
for row in rows:
    flag = "REPEAT" if row.get("repeated") else "new   "
    print("  %s %-4s %s" % (flag, row.get("kind", ""), row.get("what", "")[:100]))
' "$FEEDBACK_LOG"
  exit 0
fi

if [ "${SUBCOMMAND:-feedback}" = "update" ]; then
  # Cleanup for the re-exec copy from the guard above -- this only runs in
  # that copy, so $AGENT_TEMPLATE_UPDATE_REEXEC is always $SELF here.
  trap 'rm -f "$AGENT_TEMPLATE_UPDATE_REEXEC"' EXIT

  DRY_RUN="no"
  NO_HOST_NOTES="no"
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN="yes"; shift ;;
      --no-host-notes) NO_HOST_NOTES="yes"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) die "unknown option $1" "run agent-template update --help" ;;
    esac
  done

  REPO="${AGENT_TEMPLATE_REPO:-$HOME/projects/vstack}"
  CONFIG_DIR="${AGENT_TEMPLATE_CONFIG_DIR:-$HOME/.config/hypertask-agents}"
  SYSTEMD_USER_DIR="${AGENT_SYSTEMD_DIR:-$HOME/.config/systemd/user}"

  [ -d "$REPO/.git" ] || die "no git checkout at $REPO" \
    "set AGENT_TEMPLATE_REPO to the vstack clone, or clone it there"
  TEMPLATE_DIR="$REPO/templates/agent-skills/create-agent"
  [ -x "$TEMPLATE_DIR/install.sh" ] || die "no install.sh at $TEMPLATE_DIR" \
    "check AGENT_TEMPLATE_REPO points at the vstack checkout"

  echo "== 1. git pull --ff-only in $REPO =="
  git -C "$REPO" pull --ff-only || die "git pull --ff-only failed in $REPO" \
    "resolve it by hand (a local change or diverged history), then re-run"

  echo "== 2. install.sh (also runs the eval suite) =="
  # Always runs for real, dry-run or not: install.sh only ever copies the
  # template and refreshes the shared systemd units, both idempotent and
  # both worth doing whether or not this run also converts a conf. The
  # conf conversion and the timer restarts below are the parts --dry-run
  # actually gates. install.sh calls fail() and exits non-zero on its own
  # if the copy or the eval suite breaks; die here never runs, and nothing
  # past this point does either, so nothing is converted and nothing is
  # restarted.
  INSTALL_ARGS=()
  [ "$NO_HOST_NOTES" = "yes" ] && INSTALL_ARGS+=(--no-host-notes)
  bash "$TEMPLATE_DIR/install.sh" "${INSTALL_ARGS[@]}" \
    || die "install.sh failed (see its output above)" \
        "fix the failing step and re-run agent-template update; no conf was touched and no timer was restarted"

  echo "== 2c. shared company skills pack =="
  # install.sh above clones or fast-forwards it; this prints where it landed
  # and what it is on, so a daily update run says out loud whether every bot
  # on this host is reading the current shared rules. A pack that cannot be
  # reached is a warning, never a failure: a stale pack still runs.
  # The pack is a plugin now, and install.sh writes down which one this host
  # resolved and at what version. Fall back to describing the clone for a host
  # that never got the plugin.
  COMPANY_PACK_STAMP="${COMPANY_PACK_STAMP:-$HOME/.config/hypertask-agents/company-pack.version}"
  COMPANY_SKILLS_DIR="${COMPANY_SKILLS_DIR:-$HOME/projects/company-skills}"
  if [ -f "$COMPANY_PACK_STAMP" ]; then
    echo "  $(cat "$COMPANY_PACK_STAMP")"
  elif [ -d "$COMPANY_SKILLS_DIR/.git" ]; then
    echo "  $COMPANY_SKILLS_DIR @ $(git -C "$COMPANY_SKILLS_DIR" log -1 --format='%h %s' 2>/dev/null || echo unknown)"
  else
    echo "  WARNING: no company pack on this host. Every bot here is running on its own pack only." >&2
  fi

  echo "== 2d. the standard agent layout in every repo this host knows =="
  # Every conf names a checkout the agent works in. Lay the layout down in each
  # one, so a repo that gained an agent, or a repo whose layout drifted, is
  # brought back in line without anyone remembering to do it.
  #
  # Writes files, never commits or pushes. A daily timer that pushed to every
  # repo it knows, unattended, would be worse than leaving a clean diff for the
  # next session to carry. The diff summary below is what a maintainer reads.
  SYNC_SH="$TEMPLATE_DIR/scripts/sync-project.sh"
  [ -f "$SYNC_SH" ] || SYNC_SH="$CORE_ROOT/scripts/sync-project.sh"
  if [ ! -x "$SYNC_SH" ]; then
    echo "  WARNING: no sync-project.sh found; skipped" >&2
  else
    synced_any=no
    synced_repos=""
    for conf in $(core_conf_dirs | while IFS= read -r d; do ls -1 "$d"/*.conf 2>/dev/null; done); do
      [ -f "$conf" ] || continue
      repo="$(sed -n 's/^AGENT_REPO="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$conf" | tail -n1)"
      [ -n "$repo" ] || continue
      [ -d "$repo" ] || continue
      case " $synced_repos " in *" $repo "*) continue ;; esac
      synced_repos="$synced_repos $repo"
      synced_any=yes
      if [ "$DRY_RUN" = "yes" ]; then
        bash "$SYNC_SH" "$repo" --dry-run 2>&1 | sed 's/^/  /' || true
      else
        bash "$SYNC_SH" "$repo" 2>&1 | sed 's/^/  /' || true
      fi
    done
    [ "$synced_any" = "yes" ] || echo "  no conf names a checkout that exists on this host"
  fi

  echo "== 2b. CHANGELOG.md ACTION lines =="
  # A line marked ACTION: is a step this template cannot do for itself (a
  # human decision, an --resume, a one-off migration). Printed every run so
  # a maintainer session sees it, and appended once per version to a single
  # log so nothing is missed between runs and nothing repeats forever on a
  # daily timer.
  ACTIONS_LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-template"
  ACTIONS_LOG="$ACTIONS_LOG_DIR/actions.log"
  CHANGELOG="$TEMPLATE_DIR/CHANGELOG.md"
  TEMPLATE_VERSION="$(cat "$TEMPLATE_DIR/VERSION" 2>/dev/null || echo unknown)"
  if [ -f "$CHANGELOG" ]; then
    mkdir -p "$ACTIONS_LOG_DIR"
    touch "$ACTIONS_LOG"
    grep -E '^-?[[:space:]]*ACTION:' "$CHANGELOG" | sed -E 's/^-?[[:space:]]*ACTION:[[:space:]]*//' \
      | while IFS= read -r action; do
          [ -n "$action" ] || continue
          echo "  ACTION: $action"
          if [ "$DRY_RUN" != "yes" ] && ! grep -qF "	$TEMPLATE_VERSION	$action" "$ACTIONS_LOG"; then
            printf '%s\t%s\t%s\n' "$(date -Is)" "$TEMPLATE_VERSION" "$action" >> "$ACTIONS_LOG"
          fi
        done
  fi

  echo "== 3. old-schema confs in $CONFIG_DIR =="
  CONVERTED=0
  SKIPPED=0
  if [ -d "$CONFIG_DIR" ]; then
    for f in "$CONFIG_DIR"/*.conf; do
      [ -f "$f" ] || continue
      base="$(basename "$f" .conf)"
      grep -qE '^HT_(AGENT_ID|MODEL|MISSION|START_SECTIONS)=' "$f" || continue
      if grep -q '^BOARD_ADAPTER=' "$f"; then
        echo "  skip $base: this file already has a template conf block (BOARD_ADAPTER= present)"
        SKIPPED=$((SKIPPED + 1))
        continue
      fi
      slug="$(grep -m1 '^HT_AGENT_SLUG=' "$f" | sed -E 's/^HT_AGENT_SLUG=//; s/^"//; s/"$//' || true)"
      [ -n "$slug" ] || slug="$base"
      unit="hypertask-agent-worker@$slug.service"
      unit_state="$(systemctl --user is-enabled "$unit" 2>/dev/null || true)"
      if [ "$unit_state" = "masked" ]; then
        echo "  skip $base: old worker unit $unit is masked (retired) -- old-worker confs are historical, not converted"
        SKIPPED=$((SKIPPED + 1))
        continue
      fi
      PY_OUT="$(HOME="$HOME" python3 - "$f" "$slug" <<'PYEOF'
import os, re, sys

path, slug = sys.argv[1], sys.argv[2]
home = os.environ["HOME"]

fields = {}
with open(path, encoding="utf-8") as fh:
    for line in fh:
        m = re.match(r'^([A-Z][A-Z0-9_]*)=(.*)$', line.rstrip("\n"))
        if not m:
            continue
        key, val = m.group(1), m.group(2)
        if len(val) >= 2 and val[0] == '"' and val[-1] == '"':
            val = val[1:-1]
        fields[key] = val

def esc(v):
    return v.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("`", "\\`")

provider = fields.get("HT_PROVIDER", "")
model = fields.get("HT_MODEL", "")
if provider == "cursor":
    if not model or model == "auto":
        print("SKIP HT_PROVIDER=cursor but HT_MODEL is '%s': no concrete command can be written" % (model or "<empty>"))
        sys.exit(0)
    model_cli = "cursor-agent -p --output-format text --model %s -f --trust" % model
elif provider == "codex":
    model_cli = "codex exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check"
    if model and model != "auto":
        model_cli += " --model %s" % model
elif provider == "claude":
    model_cli = "claude -p --model %s" % (model or "sonnet")
elif provider == "pi":
    model_cli = "pi --print --tools read,bash,edit,write --no-extensions --no-skills"
    if model and model != "auto":
        model_cli += " --model %s" % model
else:
    print("SKIP HT_PROVIDER='%s' has no known MODEL_CLI mapping -- add one to agent-template before converting this slug" % provider)
    sys.exit(0)

mission = fields.get("HT_MISSION", "")
skills_index = ""
found = re.search(r'(/\S*INDEX\.md)', mission)
if found:
    skills_index = found.group(1)
if not skills_index:
    skills_index = "%s/projects/hypertask-agent-skills/INDEX.md" % home

block = "\n".join([
    'AGENT_NAME="%s"' % esc(fields.get("HT_AGENT_NAME", slug)),
    'AGENT_SLUG="%s"' % esc(slug),
    'AGENT_KIND="%s"' % esc(fields.get("HT_AGENT_MODE", "worker")),
    'AGENT_ID="%s"' % esc(fields.get("HT_AGENT_ID", "")),
    'AGENT_REPO="%s"' % esc(fields.get("HT_REPO", "")),
    'AGENT_MISSION="%s"' % esc(mission),
    'BOARD_ADAPTER="hypertask"',
    'BOARD_ID="%s"' % esc(fields.get("HT_PROJECT_ID") or fields.get("HT_BOARD", "")),
    'TOKEN_FILE="%s/.config/hypertask-agents/credentials/%s-agent-token"' % (home, slug),
    'BOARD_CLI="%s/.local/bin/%s-board"' % (home, slug),
    'WATCH_SECTIONS="%s"' % esc(fields.get("HT_START_SECTIONS", "")),
    'SKILLS_INDEX="%s"' % esc(skills_index),
    'MODEL_CLI="%s"' % esc(model_cli),
    'MAX_CONCURRENT_RUNS="1"',
])
print("CONVERT")
print(block)
PYEOF
)"
      case "$PY_OUT" in
        SKIP\ *)
          echo "  skip $base: ${PY_OUT#SKIP }"
          SKIPPED=$((SKIPPED + 1))
          ;;
        CONVERT*)
          BLOCK="$(printf '%s\n' "$PY_OUT" | tail -n +2)"
          if [ "$DRY_RUN" = "yes" ]; then
            echo "  convert $base: would append a draft template block (slug $slug; needs TOKEN_FILE + BOARD_CLI from create-agent.sh before this bot can go live)"
          else
            cp -a "$f" "$f.bak-$(date +%s)"
            core_write_missing_keys "$f" "$BLOCK"
            echo "  convert $base: draft template block appended to $f (slug $slug; needs TOKEN_FILE + BOARD_CLI from create-agent.sh before this bot can go live)"
          fi
          CONVERTED=$((CONVERTED + 1))
          ;;
        *)
          echo "  skip $base: could not read it (unexpected output: ${PY_OUT:0:120})"
          SKIPPED=$((SKIPPED + 1))
          ;;
      esac
    done
  else
    echo "  no config dir at $CONFIG_DIR, nothing to scan"
  fi

  echo "== 3b. explicit command policy for 3.14 confs =="
  MIGRATE_POLICY="$TEMPLATE_DIR/scripts/migrate-provider-policy.py"
  mapfile -t CONF_DIRS < <(core_conf_dirs)
  if [ "${#CONF_DIRS[@]}" -eq 0 ]; then
    echo "  no agent config directories on this host"
  else
    MIGRATE_ARGS=(--version "$TEMPLATE_VERSION")
    [ "$DRY_RUN" = "yes" ] && MIGRATE_ARGS+=(--dry-run)
    python3 "$MIGRATE_POLICY" "${MIGRATE_ARGS[@]}" "${CONF_DIRS[@]}"
  fi

  echo "== 3c. chat lane for template-wired agents =="
  CHAT_ENABLED=0
  if [ -d "$CONFIG_DIR" ]; then
    for f in "$CONFIG_DIR"/*.conf; do
      [ -f "$f" ] || continue
      grep -qE '^WIRING="?(poll|fleet)"?$' "$f" || continue
      grep -q '^CHAT=' "$f" && continue
      base="$(basename "$f" .conf)"
      if [ "$DRY_RUN" = "yes" ]; then
        echo "  would enable $base: append CHAT=on"
      else
        cp -a "$f" "$f.bak-$(date +%s)"
        core_write_missing_keys "$f" 'CHAT="on"'
        echo "  enabled $base: CHAT=on"
      fi
      CHAT_ENABLED=$((CHAT_ENABLED + 1))
    done
  fi
  [ "$CHAT_ENABLED" -gt 0 ] || echo "  every template-wired agent already declares CHAT"

  echo "== 4. redundant agent-board-poll@<slug>.service.d/path.conf drop-ins =="
  # core_write_poll_units (run by install.sh, step 2) now puts PATH and HOME
  # on the shared unit itself, so a per-slug drop-in that only repeats that
  # is dead weight -- and a stale copy of it would mask a future PATH fix.
  RESTART_SLUGS=""
  DROPINS_REMOVED=0
  shopt -s nullglob
  for dc in "$SYSTEMD_USER_DIR"/agent-board-poll@*.service.d/path.conf; do
    slug="$(basename "$(dirname "$dc")")"
    slug="${slug#agent-board-poll@}"
    slug="${slug%.service.d}"
    redundant="yes"
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        ""|"[Service]"|Environment=PATH=*|Environment=HOME=*) ;;
        *) redundant="no" ;;
      esac
    done < "$dc"
    if [ "$redundant" != "yes" ]; then
      echo "  keep $slug: $dc has entries beyond PATH/HOME, left it alone"
      continue
    fi
    if [ "$DRY_RUN" = "yes" ]; then
      echo "  would remove $slug: $dc (now redundant; shared unit sets the same PATH)"
      continue
    fi
    cp -a "$dc" "$dc.bak-$(date +%s)"
    rm -f "$dc"
    rmdir "$(dirname "$dc")" 2>/dev/null || true
    echo "  removed $slug: $dc (backup kept next to it; shared unit sets the same PATH now)"
    DROPINS_REMOVED=$((DROPINS_REMOVED + 1))
    RESTART_SLUGS="$RESTART_SLUGS $slug"
  done
  shopt -u nullglob

  if [ "$DRY_RUN" != "yes" ] && [ -n "$RESTART_SLUGS" ]; then
    systemctl --user daemon-reload 2>/dev/null || true
    for slug in $RESTART_SLUGS; do
      timer="agent-board-poll@$slug.timer"
      if systemctl --user is-enabled "$timer" >/dev/null 2>&1; then
        systemctl --user restart "$timer" 2>/dev/null || true
        systemctl --user reset-failed "agent-board-poll@$slug.service" 2>/dev/null || true
        echo "  restarted $timer (its unit config changed: redundant path.conf removed)"
      fi
    done
  fi

  echo "== feedback filed from this host =="
  if [ -f "$FEEDBACK_LOG" ]; then
    while IFS=$'\t' read -r ref cli; do
      [ -n "$ref" ] && [ -x "$cli" ] || continue
      task_json="$("$cli" task get "$ref" --json 2>/dev/null || true)"
      status="$(printf '%s' "$task_json" | python3 -c '
import json, sys
try:
    doc = json.load(sys.stdin)
except Exception:
    print(""); raise SystemExit
task = doc.get("task", doc) if isinstance(doc, dict) else {}
section = task.get("sectionName") or task.get("section") or ""
if isinstance(section, dict): section = section.get("name", "")
print(str(section).casefold())
')"
      case "$status" in done|rejected|declined) ;;
        "") ;;
        *) echo "feedback waiting: $ref" ;;
      esac
    done < <(python3 - "$FEEDBACK_LOG" <<'PYEOF'
import json, sys
seen = set()
rows = []
for raw in open(sys.argv[1], encoding="utf-8"):
    try: row = json.loads(raw)
    except ValueError: continue
    ref, cli = row.get("ticket", ""), row.get("board_cli", "")
    if ref and cli and ref not in seen:
        seen.add(ref); rows.append((ref, cli))
for ref, cli in rows:
    print("%s\t%s" % (ref, cli))
PYEOF
)
  else
    echo "  no feedback filed from this host"
  fi

  echo "== summary =="
  echo "$CONVERTED conf(s) converted, $SKIPPED skipped, $CHAT_ENABLED chat lane(s) enabled, $DROPINS_REMOVED redundant path.conf drop-in(s) removed"
  [ "$DRY_RUN" = "yes" ] && echo "(dry run: nothing was written, nothing was restarted)"
  feedback_print_discovery
  exit 0
fi

# agent-template feedback with no arguments at all says where things go and
# how, rather than dying on missing --what: a session that has forgotten the
# flags should not have to go read the source to find the board.
if [ "$#" -eq 0 ]; then
  feedback_usage
  exit 0
fi

WHAT=""
GOT=""
EXPECTED=""
ADAPTER=""
KIND="bug"
SLUG=""
DRY_RUN="no"
OPT_OUT="no"
CASE_IT="no"
CHECK=""

while [ $# -gt 0 ]; do
  case "$1" in
    --what) WHAT="${2:?--what needs a sentence}"; shift 2 ;;
    --got) GOT="${2:?--got needs a file or text}"; shift 2 ;;
    --expected) EXPECTED="${2:?--expected needs a sentence}"; shift 2 ;;
    --adapter) ADAPTER="${2:?--adapter needs a name}"; shift 2 ;;
    --kind) KIND="${2:?--kind needs bug, change or idea}"; shift 2 ;;
    --agent) SLUG="${2:?--agent needs a slug}"; shift 2 ;;
    --dry-run) DRY_RUN="yes"; shift ;;
    --opt-out) OPT_OUT="yes"; shift ;;
    --case) CASE_IT="yes"; shift ;;
    --check) CHECK="${2:?--check needs a predicate name}"; shift 2 ;;
    -h|--help) feedback_usage; exit 0 ;;
    *) die "unknown option $1" "run agent-template feedback --help" ;;
  esac
done

[ -n "$WHAT" ] || die "--what is missing" \
  "pass --what \"<one sentence saying what went wrong or should change>\""
[ -n "$GOT" ] || die "--got is missing" \
  "pass --got <path to the current output>, or the current context"
[ -n "$EXPECTED" ] || die "--expected is missing" \
  "pass --expected \"<the desired behavior>\""
case "$KIND" in
  bug|change|idea) ;;
  *) die "--kind must be bug, change or idea, got '$KIND'" \
        "pass --kind bug, --kind change or --kind idea" ;;
esac
if [ "$CASE_IT" = "yes" ]; then
  [ "$KIND" = "bug" ] || die "--case is only valid for --kind bug" \
    "file the change or idea without --case"
  [ -n "$CHECK" ] || die "--case needs --check" \
    "pass --check '<predicate name>', one of starts_with_block_tag, has_section \"<title>\", is_full_https_url"
  case "${CHECK%% *}" in
    starts_with_block_tag|has_section|is_full_https_url) ;;
    *) die "--check '$CHECK' is not on the allowlist" \
          "pass one of starts_with_block_tag, has_section \"<title>\", is_full_https_url; evals/run-evals.sh names the full list" ;;
  esac
fi

# ---------- who is reporting ----------
# The poll runner puts AGENT_NAME and AGENT_BOARD_CLI in the child's
# environment, so an agent mid-run needs no flags. Outside a run, --agent
# names the conf to read instead.
AGENT_NAME="${AGENT_NAME:-}"
BOARD_CLI="${AGENT_BOARD_CLI:-${BOARD_CLI:-}}"
BOARD_ADAPTER="${BOARD_ADAPTER:-}"
if [ -n "$SLUG" ]; then
  CONF="$(core_find_conf "$SLUG")" || die "no conf found for agent '$SLUG'" \
    "check the slug, or drop --agent and let the environment supply the name"
  core_read_conf "$CONF"
fi
[ -n "$AGENT_NAME" ] || AGENT_NAME="unknown"
[ -n "$ADAPTER" ] || ADAPTER="${BOARD_ADAPTER:-none}"
case "$ADAPTER" in
  hypertask|linear|none) ;;
  *) die "--adapter must be hypertask, linear or none, got '$ADAPTER'" \
        "pass one of those three" ;;
esac
[ "${FEEDBACK_OPT_OUT:-no}" = "yes" ] && OPT_OUT="yes"

# ---------- what happened ----------
if [ -f "$GOT" ]; then
  GOT_TEXT="$(cat "$GOT")"
else
  GOT_TEXT="$GOT"
fi

VERSION="$(cat "$CORE_ROOT/VERSION" 2>/dev/null || echo unknown)"
# owner/name, however the remote is written: ssh, https, with or without .git.
REPO="$(git remote get-url origin 2>/dev/null \
  | sed -E 's#\.git$##; s#/+$##; s#^.*[:/]([^:/]+/[^/]+)$#\1#' || true)"
[ -n "$REPO" ] || REPO="$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")"

TITLE="$(WHAT="$WHAT" KIND="$KIND" python3 -c '
import os
what = " ".join(os.environ["WHAT"].split())
if len(what) > 78:
    what = what[:75].rstrip() + "..."
print("%s: %s" % (os.environ["KIND"], what))')"

# ---------- repeated? ----------
# A correction is a repeat when its normalized sentence already matches an
# existing case id, a proposed one, or a line already accepted into
# PENDING-FIXES.md. A crude word-overlap check, on purpose: it only has to
# catch "this again", not stand in for the model that judges the ticket.
TEMPLATE_EVALS="$CORE_ROOT/evals"
REPEATED="$(WHAT="$WHAT" CASES="$TEMPLATE_EVALS/cases.jsonl" \
  PROPOSED="$TEMPLATE_EVALS/proposed.jsonl" PENDING="$TEMPLATE_EVALS/PENDING-FIXES.md" \
  python3 -c '
import json, os, re

def words(text):
    return {w for w in re.findall(r"[a-z0-9]+", text.casefold()) if len(w) > 2}

target = words(os.environ["WHAT"])
if not target:
    print("false")
    raise SystemExit

known = []
for path_key in ("CASES", "PROPOSED"):
    path = os.environ[path_key]
    if not os.path.isfile(path):
        continue
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                case = json.loads(line)
            except json.JSONDecodeError:
                continue
            known.append(case.get("id", "").replace("-", " "))

pending = os.environ["PENDING"]
if os.path.isfile(pending):
    with open(pending, encoding="utf-8") as fh:
        known.extend(fh.readlines())

for line in known:
    overlap = words(line)
    if not overlap:
        continue
    if len(target & overlap) / len(target) >= 0.6:
        print("true")
        raise SystemExit
print("false")
')"

BODY_FILE="$(mktemp)"
trap 'rm -f "$BODY_FILE"' EXIT
WHAT="$WHAT" GOT_TEXT="$GOT_TEXT" EXPECTED="$EXPECTED" REPO="$REPO" \
ADAPTER="$ADAPTER" VERSION="$VERSION" AGENT_NAME="$AGENT_NAME" REPEATED="$REPEATED" \
python3 - "$BODY_FILE" <<'PYEOF'
import html, os, sys

def esc(value):
    return html.escape(value, quote=False)

what = " ".join(os.environ["WHAT"].split())
got = os.environ["GOT_TEXT"].rstrip()
expected = os.environ["EXPECTED"].rstrip()

parts = [
    "<p><strong>%s</strong></p>" % esc(what),
    "<p><strong>Current behavior or context</strong></p>",
    "<pre>%s</pre>" % esc(got),
    "<p><strong>Desired behavior</strong></p>",
    "<pre>%s</pre>" % esc(expected),
    "<ul>",
    "<li>repo: <code>%s</code></li>" % esc(os.environ["REPO"]),
    "<li>adapter: <code>%s</code></li>" % esc(os.environ["ADAPTER"]),
    "<li>template version: <code>%s</code></li>" % esc(os.environ["VERSION"]),
    "<li>agent: <code>%s</code></li>" % esc(os.environ["AGENT_NAME"]),
    "<li>repeated: <code>%s</code></li>" % esc(os.environ["REPEATED"]),
    "</ul>",
]
with open(sys.argv[1], "w", encoding="utf-8") as fh:
    fh.write("".join(parts))
PYEOF

LABELS="$KIND"
case "$ADAPTER" in
  hypertask|linear) LABELS="$LABELS,adapter:$ADAPTER" ;;
  none) LABELS="$LABELS,core" ;;
esac
[ "$REPEATED" = "true" ] && LABELS="$LABELS,repeated"

print_and_paste() {
  # The honest fallback: no board write is possible, so hand the body to
  # whoever is reading and say exactly where it goes.
  printf 'Title: %s\nLabels: %s\nBoard: %s (column %s)\n\n' \
    "$TITLE" "$LABELS" "$FEEDBACK_BOARD_URL" "$FEEDBACK_BOARD_SECTION"
  cat "$BODY_FILE"
  printf '\n\nPaste that at %s in the %s column.\n' \
    "$FEEDBACK_BOARD_URL" "$FEEDBACK_BOARD_SECTION"
}

# log_feedback : one line in the local log every call leaves, sent or not.
# agent-template report reads this; it is not a board write and needs no
# credentials.
log_feedback() {
  local ticket="${1:-}" board_cli="${2:-}"
  mkdir -p "$FEEDBACK_LOG_DIR"
  WHAT="$WHAT" KIND="$KIND" ADAPTER="$ADAPTER" AGENT_NAME="$AGENT_NAME" \
  REPEATED="$REPEATED" CASE_IT="$CASE_IT" TICKET="$ticket" LOG_BOARD_CLI="$board_cli" python3 -c '
import datetime, json, os
print(json.dumps({
    "date": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "what": " ".join(os.environ["WHAT"].split()),
    "kind": os.environ["KIND"],
    "adapter": os.environ["ADAPTER"],
    "agent": os.environ["AGENT_NAME"],
    "repeated": os.environ["REPEATED"] == "true",
    "case": os.environ["CASE_IT"] == "yes",
    "ticket": os.environ["TICKET"],
    "board_cli": os.environ["LOG_BOARD_CLI"],
}))' >> "$FEEDBACK_LOG"
}

# append_proposed_case <source-url> : evals/proposed.jsonl lives in the
# vstack checkout, not $CORE_ROOT -- install.sh empties $CORE_ROOT/evals on
# every install, so anything appended to the installed copy is thrown away
# on the next one.
append_proposed_case() {
  local source="$1" repo_dir proposed
  [ "$CASE_IT" = "yes" ] || return 0
  repo_dir="${AGENT_TEMPLATE_REPO:-$HOME/projects/vstack}"
  proposed="$repo_dir/templates/agent-skills/create-agent/evals/proposed.jsonl"
  if [ ! -d "$(dirname "$proposed")" ]; then
    warn "no evals folder at $(dirname "$proposed"): the proposed case was not written. Do this next: set AGENT_TEMPLATE_REPO to the vstack checkout"
    return 0
  fi
  CASE_ID="$(WHAT="$WHAT" python3 -c '
import os, re, time
slug = re.sub(r"[^a-z0-9]+", "-", os.environ["WHAT"].casefold()).strip("-")[:50]
print("%s-%d" % (slug or "case", int(time.time())))')"
  WHAT="$WHAT" KIND="$KIND" ADAPTER="$ADAPTER" CHECK="$CHECK" \
  EXPECTED="$EXPECTED" SOURCE="$source" CASE_ID="$CASE_ID" python3 -c '
import datetime, json, os
print(json.dumps({
    "id": os.environ["CASE_ID"],
    "adapter": os.environ["ADAPTER"],
    "kind": os.environ["KIND"],
    "input": os.environ["EXPECTED"].rstrip(),
    "check": os.environ["CHECK"],
    "source": os.environ["SOURCE"],
    "added": datetime.date.today().isoformat(),
}))' >> "$proposed"
  echo "proposed case $CASE_ID appended to $proposed"
}

if [ "$OPT_OUT" = "yes" ]; then
  echo "feedback is opted out (FEEDBACK_OPT_OUT=yes or --opt-out): nothing sent."
  print_and_paste
  log_feedback
  append_proposed_case "$FEEDBACK_BOARD_URL (not filed: opted out)"
  exit 0
fi

if [ "$DRY_RUN" = "yes" ]; then
  echo "(dry run: nothing sent)"
  print_and_paste
  exit 0
fi

# ---------- send ----------
# The board write goes through the agent's own CLI wrapper, so the ticket
# carries the agent's name and the token stays in its 0600 file. Anything
# else and there is nothing authenticated to post with.
if [ "$ADAPTER" != "hypertask" ] || [ -z "$BOARD_CLI" ] || [ ! -x "$BOARD_CLI" ]; then
  echo "no board CLI for this agent, so this correction cannot be filed automatically." >&2
  print_and_paste
  log_feedback
  append_proposed_case "$FEEDBACK_BOARD_URL (not filed: no board CLI)"
  exit 0
fi

LABELS_USED="$LABELS"
# The real board CLI (`hypertask task create`, checked against its own
# `capabilities --json` catalog) has no --description-file option, only
# --description <text>. The call used to send --description-file anyway,
# which this CLI rejects as an unknown flag: STATUS came back non-zero on
# every single post, and every feedback call fell through to the
# print-and-paste fallback and looked like "always refused", token and all.
BODY_TEXT="$(cat "$BODY_FILE")"
if OUT="$("$BOARD_CLI" task create \
      --project "$FEEDBACK_BOARD_ID" \
      --section "$FEEDBACK_BOARD_SECTION" \
      --title "$TITLE" \
      --description "$BODY_TEXT" \
      --labels "$LABELS" --json 2>&1)"; then
  STATUS=0
else
  STATUS=$?
fi
# A label this board's project does not carry (board 2462 had none of
# $LABELS) used to fail the whole post, which fell through to the
# print-and-paste fallback and looked like "feedback never posts". The
# ticket itself matters more than the label: retry once with no label and
# say so in one line, instead of losing the post over it.
if [ "$STATUS" -ne 0 ] && printf '%s' "$OUT" | grep -qi "LabelNotFound"; then
  echo "label(s) $LABELS_USED not on this board's project: filing without a label"
  LABELS_USED=""
  if OUT="$("$BOARD_CLI" task create \
        --project "$FEEDBACK_BOARD_ID" \
        --section "$FEEDBACK_BOARD_SECTION" \
        --title "$TITLE" \
        --description "$BODY_TEXT" --json 2>&1)"; then
    STATUS=0
  else
    STATUS=$?
  fi
fi
if [ "$STATUS" -eq 0 ]; then
  FILED_LINE="$(printf '%s\n' "$OUT" | python3 -c '
import json, re, sys
raw = sys.stdin.read()
start, end = raw.find("{"), raw.rfind("}")
if start == -1 or end <= start:
    print(raw.strip())
    sys.exit(0)
try:
    doc = json.loads(raw[start:end + 1])
except json.JSONDecodeError:
    print(raw.strip())
    sys.exit(0)
task = doc.get("task") if isinstance(doc.get("task"), dict) else doc
ref = task.get("ticketNumber") or ""
index = task.get("uniqueIndex") or (ref.rsplit("-", 1)[-1] if "-" in ref else "")
project = task.get("projectId") or task.get("boardId") or ""
if index and project:
    print("filed %s https://app.hypertask.ai/detail/project-%s/%s" % (ref, project, index))
else:
    print("filed: %s" % raw.strip()[:200])
')"
  echo "$FILED_LINE"
  FILED_URL="$(printf '%s\n' "$FILED_LINE" | grep -oE 'https://\S+' | head -1)" || FILED_URL=""
  FILED_REF="$(printf '%s\n' "$FILED_LINE" | sed -n 's/^filed \([A-Z0-9]*-[0-9]*\) .*/\1/p')"
  log_feedback "$FILED_REF" "$BOARD_CLI"
  append_proposed_case "${FILED_URL:-$FEEDBACK_BOARD_URL}"
else
  echo "the board refused the ticket, so here it is to paste by hand:" >&2
  printf '%s\n' "$OUT" >&2
  print_and_paste
  log_feedback
  append_proposed_case "$FEEDBACK_BOARD_URL (not filed: the board refused it)"
  exit 0
fi
