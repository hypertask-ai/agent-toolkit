#!/usr/bin/env bash
# Keep board columns in sync with durable agent runs and merged pull requests.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CORE_ROOT="$(dirname "$(dirname "$SELF")")"
# shellcheck disable=SC1091
. "$CORE_ROOT/scripts/lib/core.sh"

STATE_DIR="${AGENT_BOARD_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/agent-board-poll}"
CONFIG_DIR="${AGENT_CONFIG_DIR:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --state-dir) STATE_DIR="${2:?--state-dir needs a path}"; shift 2 ;;
    --config-dir) CONFIG_DIR="${2:?--config-dir needs a path}"; shift 2 ;;
    -h|--help) echo "usage: agent-board-reconcile [--state-dir PATH] [--config-dir PATH]"; exit 0 ;;
    *) die "unknown option $1" "run agent-board-reconcile --help" ;;
  esac
done
mkdir -p "$STATE_DIR/run-records"
MERGED_SCANS="$STATE_DIR/reconcile-merged-scans.$$"
DIRECT_REPOS="$STATE_DIR/reconcile-direct-repos.$$"
DIRECT_COMMITS="$STATE_DIR/reconcile-direct-commits.$$"
DIRECT_CURSORS="$STATE_DIR/reconcile-direct-cursors.$$"
: > "$MERGED_SCANS"
: > "$DIRECT_REPOS"
: > "$DIRECT_COMMITS"
: > "$DIRECT_CURSORS"
trap 'rm -f "$MERGED_SCANS" "$DIRECT_REPOS" "$DIRECT_COMMITS" "$DIRECT_CURSORS"' EXIT

record_field() {
  local path="$1" field="$2"
  FIELD="$field" python3 - "$path" <<'PYEOF'
import json, os, sys
try:
    row = json.load(open(sys.argv[1], encoding="utf-8"))
except (OSError, ValueError):
    row = {}
print(row.get(os.environ["FIELD"]) or "")
PYEOF
}

record_is_live() {
  local path="$1" pid status
  status="$(record_field "$path" status)"
  [ "$status" = "running" ] || return 1
  pid="$(record_field "$path" pid)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  pgrep -f 'agent-board-poll([[:space:]]|$)' 2>/dev/null | grep -qxF "$pid"
}

record_preserves_ticket() {
  local action
  action="$(record_field "$1" reconciliation_action)"
  case "$action" in owner-hold|alarm|pr-binding) return 0 ;; esac
  return 1
}

CONF_FILES=()
if [ -n "$CONFIG_DIR" ]; then
  for conf in "$CONFIG_DIR"/*.conf; do [ ! -f "$conf" ] || CONF_FILES+=("$conf"); done
else
  while IFS= read -r dir; do
    for conf in "$dir"/*.conf; do [ ! -f "$conf" ] || CONF_FILES+=("$conf"); done
  done < <(core_conf_dirs)
fi

ALLOW_FILES=()
for conf in "${CONF_FILES[@]}"; do
  allow_file="$(dirname "$conf")/repos.allow"
  [ ! -f "$allow_file" ] || ALLOW_FILES+=("$allow_file")
done
if [ "${#ALLOW_FILES[@]}" -gt 0 ]; then
  python3 - "${ALLOW_FILES[@]}" > "$DIRECT_REPOS" <<'PYEOF'
import csv
import sys

seen = set()
for path in sys.argv[1:]:
    with open(path, encoding="utf-8", newline="") as handle:
        for row in csv.reader(line for line in handle if line.strip() and not line.lstrip().startswith("#")):
            row = [value.strip() for value in row]
            if len(row) not in (4, 5):
                continue
            key, checkout, slug, base = row[:4]
            item = (key, checkout, slug, base)
            if checkout and "/" in slug and base and item not in seen:
                seen.add(item)
                print("\t".join(item))
PYEOF
fi

DIRECT_CURSOR_DIR="$STATE_DIR/direct-commit-cursors"
mkdir -p "$DIRECT_CURSOR_DIR"
while IFS=$'\t' read -r repo_key repo_path repo_slug base_branch; do
  [ -n "$repo_path" ] || continue
  repo_hash="$(printf '%s\0%s\0%s' "$repo_path" "$repo_slug" "$base_branch" | sha256sum | cut -c1-24)"
  cursor="$DIRECT_CURSOR_DIR/$repo_hash"
  remote_ref="refs/remotes/origin/$base_branch"
  if ! git -C "$repo_path" fetch --quiet origin \
      "+refs/heads/$base_branch:$remote_ref" 2>>"$STATE_DIR/reconcile.log"; then
    printf '%s direct-commit scan could not fetch %s %s\n' \
      "$(date -Is)" "$repo_slug" "$base_branch" >> "$STATE_DIR/reconcile.log"
    continue
  fi
  if ! tip="$(git -C "$repo_path" rev-parse --verify "$remote_ref^{commit}" 2>>"$STATE_DIR/reconcile.log")"; then
    printf '%s direct-commit scan could not resolve %s %s\n' \
      "$(date -Is)" "$repo_slug" "$base_branch" >> "$STATE_DIR/reconcile.log"
    continue
  fi
  cursor_sha=""
  [ ! -s "$cursor" ] || read -r cursor_sha < "$cursor"
  if [[ "$cursor_sha" =~ ^[0-9a-fA-F]{40,64}$ ]]; then
    commits="$(git -C "$repo_path" log --reverse --format='%H%x09%s' \
      "$cursor_sha..$remote_ref" 2>>"$STATE_DIR/reconcile.log")" || continue
  else
    commits="$(git -C "$repo_path" log --reverse --format='%H%x09%s' \
      --since='48 hours ago' "$remote_ref" 2>>"$STATE_DIR/reconcile.log")" || continue
  fi
  while IFS=$'\t' read -r sha subject; do
    [[ "$sha" =~ ^[0-9a-fA-F]{40,64}$ ]] || continue
    subject="${subject//$'\t'/ }"
    printf '%s\t%s\t%s\thttps://github.com/%s/commit/%s\n' \
      "$repo_slug" "$sha" "$subject" "$repo_slug" "$sha" >> "$DIRECT_COMMITS"
  done <<< "$commits"
  printf '%s\t%s\n' "$cursor" "$tip" >> "$DIRECT_CURSORS"
done < "$DIRECT_REPOS"

for conf in "${CONF_FILES[@]}"; do
  (
    unset AGENT_ID AGENT_NAME AGENT_SLUG BOARD_ADAPTER BOARD_ID BOARD_CLI TOKEN_FILE PR_REPO PR_BRANCH_PREFIX DONE_SECTION
    # shellcheck disable=SC1090
    . "$conf"
    [ "${BOARD_ADAPTER:-}" = "hypertask" ] || exit 0
    slug="${AGENT_SLUG:-$(basename "$conf" .conf)}"
    : "${AGENT_ID:?missing AGENT_ID in $conf}" "${BOARD_ID:?missing BOARD_ID in $conf}"
    : "${BOARD_CLI:?missing BOARD_CLI in $conf}" "${TOKEN_FILE:?missing TOKEN_FILE in $conf}"
    IN_PROGRESS_SECTION="${IN_PROGRESS_SECTION:-In Progress}"
    DONE_SECTION="${DONE_SECTION:-Done}"
    PR_BRANCH_PREFIX="${PR_BRANCH_PREFIX:-agent/$slug-}"
    log="$STATE_DIR/$slug.log"
    opened="$STATE_DIR/$slug.opened-prs"
    touch "$log" "$opened"
    STATE_DIR="$STATE_DIR"
    SLUG="$slug"
    export STATE_DIR SLUG
    core_load_adapter "$BOARD_ADAPTER"

    health_log() {
      local board="$1" message="$2" health_ref
      health_ref="$(BOARD="$board" python3 - "$STATE_DIR/board-health.json" <<'PYEOF'
import json, os, sys
try:
    row = json.load(open(sys.argv[1], encoding="utf-8"))
except (OSError, ValueError):
    row = {}
print(((row.get("boards") or {}).get(os.environ["BOARD"]) or {}).get("ref") or "")
PYEOF
)"
      if [ -n "$health_ref" ] && AGENT_COMMENT_VERBATIM=yes "$BOARD_CLI" comment add "$health_ref" \
          --text "<p><strong>Decision: $message</strong></p>" >>"$log" 2>&1; then
        return 0
      fi
      printf '%s board health: %s\n' "$(date -Is)" "$message" >> "$log"
    }

    for record in "$STATE_DIR/run-records/$slug-"*.json; do
      [ -f "$record" ] || continue
      record_is_live "$record" || continue
      ref="$(record_field "$record" ref)"
      board="$(record_field "$record" board)"
      current="$(adapter_current_section "$BOARD_CLI" "$ref" 2>>"$log" || true)"
      [ "${current,,}" != "${DONE_SECTION,,}" ] || continue
      if [ "${current,,}" != "${IN_PROGRESS_SECTION,,}" ]; then
        if ! adapter_assign_task "$BOARD_CLI" "$ref" "$AGENT_ID" >>"$log" 2>&1 \
           || ! adapter_move_task "$BOARD_CLI" "$ref" "$IN_PROGRESS_SECTION" >>"$log" 2>&1; then
          health_log "$board" "Reconciler could not keep live run $ref in $IN_PROGRESS_SECTION after two attempts."
        fi
      fi
    done

    rows="$(adapter_list_candidates "$TOKEN_FILE" "$BOARD_ID" "$IN_PROGRESS_SECTION" 2>>"$log" || true)"
    while IFS= read -r row; do
      [ -n "$row" ] || continue
      assigned="$(ROW="$row" AID="$AGENT_ID" python3 -c 'import json,os; print("yes" if os.environ["AID"] in json.loads(os.environ["ROW"]).get("agent_ids", []) else "no")')"
      [ "$assigned" = "yes" ] || continue
      ref="$(ROW="$row" python3 -c 'import json,os; print(json.loads(os.environ["ROW"]).get("ref") or "")')"
      board="$(ROW="$row" python3 -c 'import json,os; print(json.loads(os.environ["ROW"]).get("board") or "")')"
      record="$STATE_DIR/run-records/$slug-$ref.json"
      if [ -f "$record" ] && { record_is_live "$record" || record_preserves_ticket "$record"; }; then continue; fi
      set +e
      adapter_agent_has_open_pr "${PR_REPO:-}" "$ref" "$PR_BRANCH_PREFIX" "$opened"
      pr_rc=$?
      set -e
      [ "$pr_rc" -ne 0 ] || continue
      if [ "$pr_rc" -eq 2 ]; then
        health_log "$board" "Reconciler could not check open pull requests for $ref, so it left the ticket in $IN_PROGRESS_SECTION."
        continue
      fi
      origin=""
      [ ! -f "$record" ] || origin="$(record_field "$record" origin_section)"
      if [ -z "$origin" ]; then
        health_log "$board" "Reconciler found stale $ref in $IN_PROGRESS_SECTION without a recorded origin section."
        continue
      fi
      if adapter_move_task "$BOARD_CLI" "$ref" "$origin" >>"$log" 2>&1; then
        RECORD_STATUS=reconciled python3 - "$record" <<'PYEOF'
import json, os, sys
path = sys.argv[1]
row = json.load(open(path, encoding="utf-8"))
row["status"] = os.environ["RECORD_STATUS"]
row["reconciled_at"] = __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat()
temporary = path + ".new"
with open(temporary, "w", encoding="utf-8") as handle:
    json.dump(row, handle, sort_keys=True); handle.write("\n")
os.replace(temporary, path)
PYEOF
        health_log "$board" "Reconciler returned stale $ref from $IN_PROGRESS_SECTION to $origin because no live run or open agent pull request remained."
      else
        health_log "$board" "Reconciler could not return stale $ref to $origin after two attempts."
      fi
    done <<< "$rows"

    if [ -s "$DIRECT_COMMITS" ]; then
      direct_rows="$(adapter_list_candidates "$TOKEN_FILE" "$BOARD_ID" "*" 2>>"$log" || true)"
      while IFS=$'\t' read -r commit_repo commit_sha commit_title commit_url; do
        if [[ "$commit_title" =~ ^([A-Z][A-Z0-9]*-[0-9]+)($|[[:space:]:]) ]]; then
          ref="${BASH_REMATCH[1]}"
        else
          continue
        fi
        row="$(printf '%s\n' "$direct_rows" | REF="$ref" python3 -c '
import json, os, sys
wanted = os.environ["REF"].casefold()
for line in sys.stdin:
    try:
        row = json.loads(line)
    except ValueError:
        continue
    if str(row.get("ref") or "").casefold() == wanted:
        print(json.dumps(row))
        sys.stdin.read()
        break
')"
        [ -n "$row" ] || continue
        fields="$(ROW="$row" python3 -c '
import json, os
row = json.loads(os.environ["ROW"])
print(row.get("board") or "")
print(row.get("section") or "")
')"
        { IFS= read -r board; IFS= read -r section; } <<< "$fields"
        current="$(adapter_current_section "$BOARD_CLI" "$ref" 2>>"$log" || true)"
        [ -n "$current" ] || current="$section"
        current_lower="${current,,}"
        if [ "$current_lower" = "${DONE_SECTION,,}" ] \
           || [ "$current_lower" = "archived" ] || [ "$current_lower" = "archive" ]; then
          continue
        fi
        if ! adapter_move_task "$BOARD_CLI" "$ref" "$DONE_SECTION" >>"$log" 2>&1; then
          health_log "$board" "Reconciler could not move $ref to $DONE_SECTION after direct commit ${commit_sha:0:7} shipped."
          continue
        fi
        current="$(adapter_current_section "$BOARD_CLI" "$ref" 2>>"$log" || true)"
        if [ "${current,,}" != "${DONE_SECTION,,}" ]; then
          health_log "$board" "Reconciler could not verify $ref in $DONE_SECTION after direct commit ${commit_sha:0:7} shipped."
          continue
        fi
        if ! adapter_clear_assignees "$BOARD_CLI" "$ref" >>"$log" 2>&1; then
          health_log "$board" "Reconciler moved $ref to $DONE_SECTION for direct commit ${commit_sha:0:7}, but could not clear its assignees."
        fi
        shipped_comment="Shipped by commit ${commit_sha:0:7} $commit_url, moved to Done."
        if AGENT_COMMENT_VERBATIM=yes "$BOARD_CLI" comment add "$ref" --raw \
            --text "$shipped_comment" >>"$log" 2>&1; then
          printf '%s reconciler moved %s to %s because direct commit %s shipped in %s\n' \
            "$(date -Is)" "$ref" "$DONE_SECTION" "$commit_sha" "$commit_repo" >> "$log"
        else
          health_log "$board" "Reconciler moved $ref to $DONE_SECTION for direct commit ${commit_sha:0:7}, but could not post its shipping comment."
        fi
      done < "$DIRECT_COMMITS"
    fi

    scan_key="${PR_REPO:-}\t$BOARD_ID"
    if ! grep -qxF "$scan_key" "$MERGED_SCANS"; then
      printf '%s\n' "$scan_key" >> "$MERGED_SCANS"
      rows="$(adapter_list_candidates "$TOKEN_FILE" "$BOARD_ID" "*" 2>>"$log" || true)"
      while IFS= read -r row; do
        [ -n "$row" ] || continue
        fields="$(ROW="$row" python3 -c '
import json, os
row = json.loads(os.environ["ROW"])
print(row.get("id") or "")
print(row.get("ref") or "")
print(row.get("board") or "")
print(row.get("section") or "")
')"
        { IFS= read -r task_id; IFS= read -r ref; IFS= read -r board; IFS= read -r section; } <<< "$fields"
        current="$(adapter_current_section "$BOARD_CLI" "$ref" 2>>"$log" || true)"
        [ -n "$current" ] || current="$section"
        current_lower="${current,,}"
        if [ "$current_lower" = "${DONE_SECTION,,}" ] \
           || [ "$current_lower" = "archived" ] || [ "$current_lower" = "archive" ]; then
          continue
        fi
        record="$STATE_DIR/run-records/$slug-$ref.json"
        if [ -f "$record" ] && { record_is_live "$record" || record_preserves_ticket "$record"; }; then continue; fi
        set +e
        merged_url="$(adapter_ticket_merged_pr "$TOKEN_FILE" "$board" "$task_id" "${PR_REPO:-}" "$ref" 2>>"$log")"
        merged_rc=$?
        set -e
        if [ "$merged_rc" -eq 2 ]; then
          health_log "$board" "Reconciler could not check merged pull requests for $ref, so it left the ticket in $current."
          continue
        fi
        [ "$merged_rc" -eq 0 ] || continue
        if ! adapter_move_task "$BOARD_CLI" "$ref" "$DONE_SECTION" >>"$log" 2>&1; then
          health_log "$board" "Reconciler could not move $ref to $DONE_SECTION after $merged_url merged."
          continue
        fi
        current="$(adapter_current_section "$BOARD_CLI" "$ref" 2>>"$log" || true)"
        if [ "${current,,}" != "${DONE_SECTION,,}" ]; then
          health_log "$board" "Reconciler could not verify $ref in $DONE_SECTION after $merged_url merged."
          continue
        fi
        if ! adapter_clear_assignees "$BOARD_CLI" "$ref" >>"$log" 2>&1; then
          health_log "$board" "Reconciler moved $ref to $DONE_SECTION for $merged_url, but could not clear its assignees."
        fi
        shipped_comment="Shipped by merged pull request $merged_url, moved to Done."
        if AGENT_COMMENT_VERBATIM=yes "$BOARD_CLI" comment add "$ref" --raw \
            --text "$shipped_comment" >>"$log" 2>&1; then
          printf '%s reconciler moved %s to %s because %s is merged\n' \
            "$(date -Is)" "$ref" "$DONE_SECTION" "$merged_url" >> "$log"
        else
          health_log "$board" "Reconciler moved $ref to $DONE_SECTION for $merged_url, but could not post its shipping comment."
        fi
      done <<< "$rows"
    fi
  )
done

while IFS=$'\t' read -r cursor tip; do
  [ -n "$cursor" ] && [ -n "$tip" ] || continue
  printf '%s\n' "$tip" > "$cursor.new"
  mv "$cursor.new" "$cursor"
done < "$DIRECT_CURSORS"
