#!/usr/bin/env python3
"""Collect and publish the public agent factory snapshot."""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import math
import os
import re
import shlex
import sys
import urllib.error
import urllib.parse
import urllib.request
from collections import defaultdict
from pathlib import Path
from typing import Any

MAX_BYTES = 256 * 1024
TICKET = re.compile(r"^[A-Z][A-Z0-9]{0,15}-([1-9][0-9]*)$")
IDENTITY = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.:-]{0,239}$")
STAMP = re.compile(r"^(\S+) (.*)$")
RUN_START = re.compile(r"\brun start ([A-Z][A-Z0-9]{0,15}-[1-9][0-9]*)\b")
RUN_END = re.compile(r"\brun (done|FAILED) ([A-Z][A-Z0-9]{0,15}-[1-9][0-9]*)\b(?: exit=(-?\d+))?")
MODEL_ROUTE = re.compile(r"\bmodel route for ([A-Z][A-Z0-9]{0,15}-[1-9][0-9]*): [^(]*(?:\((.*)\))?$")
QA_OUTCOME = re.compile(r"\bQA outcome ([A-Z][A-Z0-9]{0,15}-[1-9][0-9]*) verdict=(Done|Handoff)\b", re.I)
QA_MOVE_OUTCOME = re.compile(r"\bQA (?:run fallback|backfill comment \S+) moved ([A-Z][A-Z0-9]{0,15}-[1-9][0-9]*) .* verdict (Done|Handoff)\b", re.I)


def parse_time(value: Any) -> float | None:
    if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) and value >= 0:
        return float(value)
    if not isinstance(value, str) or not value:
        return None
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def iso(value: float) -> str:
    return dt.datetime.fromtimestamp(value, dt.timezone.utc).isoformat().replace("+00:00", "Z")


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def parse_env(path: Path) -> dict[str, str]:
    result: dict[str, str] = {}
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return result
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.removeprefix("export ").split("=", 1)
        key = key.strip()
        if not re.fullmatch(r"[A-Z][A-Z0-9_]*", key):
            continue
        value = value.strip()
        try:
            words = shlex.split(value, posix=True)
        except ValueError:
            continue
        if len(words) == 1:
            result[key] = words[0]
    return result


def role_of(config: dict[str, str], slug: str) -> str | None:
    explicit = config.get("AGENT_ROLE", "").lower()
    if explicit in {"dev", "qa", "manager"}:
        return explicit
    kind = config.get("AGENT_KIND", "").lower()
    if config.get("MANAGER") == "on" or slug == "product-bot" or kind == "manager":
        return "manager"
    if kind == "qa" or (slug.startswith("tk-") and "qa" in slug):
        return "qa"
    return "dev"


def model_name(command: str) -> str:
    try:
        words = shlex.split(command)
    except ValueError:
        words = command.split()
    for index, word in enumerate(words):
        if word == "--model" and index + 1 < len(words):
            return words[index + 1]
        if word.startswith("--model="):
            return word.split("=", 1)[1]
    return Path(words[0]).name if words else "unknown"


def provider_of(model: str, command: str) -> str:
    value = f"{model} {command}".lower()
    if "cursor" in value or "grok" in value:
        return "cursor"
    if "claude" in value or "sonnet" in value or "opus" in value:
        return "claude"
    if "codex" in value or "gpt" in value or "hax" in value:
        return "codex"
    return model or "unknown"


def parse_log(path: Path, default_model: str, now: float) -> tuple[str, list[dict[str, Any]], list[dict[str, Any]], float | None]:
    phase = "idle"
    starts: dict[str, list[dict[str, Any]]] = defaultdict(list)
    runs: list[dict[str, Any]] = []
    outcomes: list[dict[str, Any]] = []
    observed_at = None
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return "unknown", runs, outcomes, observed_at
    for line in lines:
        stamped = STAMP.match(line)
        if not stamped:
            continue
        at = parse_time(stamped.group(1))
        if at is None:
            continue
        text = stamped.group(2)
        observed_at = at
        start = RUN_START.search(text)
        if start:
            row = {"ticket": start.group(1), "started_at": at, "ended_at": None, "result": "incomplete", "model": default_model}
            starts[row["ticket"]].append(row)
            runs.append(row)
            phase = "working"
            continue
        route = MODEL_ROUTE.search(text)
        if route and starts[route.group(1)]:
            command = route.group(2) or text
            starts[route.group(1)][-1]["model"] = model_name(command)
            continue
        end = RUN_END.search(text)
        if end:
            candidates = starts[end.group(2)]
            row = next((candidate for candidate in reversed(candidates) if candidate["ended_at"] is None), None)
            if row:
                row["ended_at"] = at
                row["result"] = "succeeded" if end.group(1) == "done" and (end.group(3) in (None, "0")) else "failed"
            phase = "idle"
        outcome = QA_OUTCOME.search(text) or QA_MOVE_OUTCOME.search(text)
        if outcome:
            outcomes.append({"ticket": outcome.group(1), "outcome": "done" if outcome.group(2).lower() == "done" else "returned", "at": at})
    if runs and runs[-1]["ended_at"] is None and now - runs[-1]["started_at"] <= 12 * 3600:
        phase = "working"
    return phase, runs, outcomes, observed_at


def ticket_from_lock(lock: dict[str, Any]) -> dict[str, Any] | None:
    key = str(lock.get("ticket") or "")
    match = TICKET.fullmatch(key)
    board = lock.get("board_id")
    identity = lock.get("ticket_id")
    title = lock.get("title")
    if not match or not isinstance(board, int) or board <= 0 or not isinstance(identity, int) or identity <= 0:
        return None
    if not isinstance(title, str) or not title.strip() or any(ord(char) < 32 or ord(char) == 127 for char in title):
        return None
    return {
        "board_id": board,
        "ticket_id": identity,
        "ticket_key": key,
        "title": title[:10000],
        "url": f"https://app.hypertask.ai/detail/project-{board}/{match.group(1)}",
    }


def incident_rows(health: dict[str, Any], slugs: set[str], now: float) -> list[dict[str, Any]]:
    checked = parse_time(health.get("at")) or now
    rows = []
    for index, violation in enumerate(health.get("violations") if isinstance(health.get("violations"), list) else []):
        if not isinstance(violation, dict):
            continue
        what = str(violation.get("what") or "")
        digest = hashlib.sha256(json.dumps(violation, sort_keys=True).encode()).hexdigest()[:16]
        ticket = what if TICKET.fullmatch(what) else None
        affected = what if what in slugs else None
        rows.append({
            "id": f"supervisor:{digest}", "episode": checked, "state": "unresolved", "current": True,
            "affected_agent_slug": affected, "ticket_key": ticket, "owner": "product-bot" if "product-bot" in slugs else None,
            "action_kind": "review_due", "action_summary": "Review the overdue recovery action.",
            "detected_at": checked, "last_seen_at": checked, "next_deadline": None,
            "attention_required": "review_due", "coalesced_into": None, "related_incident_ids": [],
            "resolved_at": None, "resolution_kind": "unverified", "verification": None,
        })
        if index == 499:
            break
    return rows


def calculate_metrics(runs: list[dict[str, Any]], outcomes: list[dict[str, Any]], now: float) -> dict[str, Any]:
    cutoff = now - 7 * 86400
    days = [(dt.datetime.fromtimestamp(now, dt.timezone.utc).date() - dt.timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]
    recent_runs = [row for row in runs if row["started_at"] >= cutoff and row.get("ended_at") is not None]
    by_model: dict[str, float] = defaultdict(float)
    by_provider: dict[str, float] = defaultdict(float)
    provider_daily: dict[str, dict[str, float]] = defaultdict(lambda: defaultdict(float))
    completed: set[str] = set()
    for row in recent_runs:
        duration = max(0.0, row["ended_at"] - row["started_at"])
        day = dt.datetime.fromtimestamp(row["started_at"], dt.timezone.utc).date().isoformat()
        by_model[row["model"]] += duration
        by_provider[row["provider"]] += duration
        provider_daily[day][row["provider"]] += duration
        if row["result"] == "succeeded":
            completed.add(row["ticket"])
    recent_outcomes = sorted((item for item in outcomes if item["at"] >= cutoff), key=lambda item: item["at"])
    first: dict[str, str] = {}
    latest: dict[str, dict[str, Any]] = {}
    for row in recent_outcomes:
        first.setdefault(row["ticket"], row["outcome"])
        latest[row["ticket"]] = row
    passed = sum(value == "done" for value in first.values())
    live = [row for row in latest.values() if row["outcome"] == "done"]
    live_by_day = {day: sum(dt.datetime.fromtimestamp(row["at"], dt.timezone.utc).date().isoformat() == day for row in live) for day in days}
    total_seconds = sum(by_provider.values())
    live_count = len(live)
    provider_percent = {
        provider: round(seconds * 100 / total_seconds / live_count, 2)
        for provider, seconds in by_provider.items()
    } if total_seconds and live_count else {}
    cost_daily = []
    for day in days:
        day_total = sum(provider_daily[day].values())
        denominator = live_by_day[day]
        cost_daily.append({"date": day, **{
            provider: round(provider_daily[day].get(provider, 0) * 100 / day_total / denominator, 2) if day_total and denominator else None
            for provider in ("cursor", "claude", "codex")
        }})
    first_daily = []
    for day in days:
        rows = [ticket for ticket, outcome in first.items() if next(
            (dt.datetime.fromtimestamp(row["at"], dt.timezone.utc).date().isoformat() for row in recent_outcomes if row["ticket"] == ticket), ""
        ) == day]
        day_passed = sum(first[ticket] == "done" for ticket in rows)
        first_daily.append({"date": day, "passed": day_passed, "total": len(rows), "rate": round(day_passed * 100 / len(rows), 1) if rows else None})
    divisor = len(completed) or 1
    return {
        "window_days": 7,
        "live_tickets": {"count": live_count, "daily": [{"date": day, "agents": live_by_day[day], "all": live_by_day[day]} for day in days]},
        "first_pass": {"passed": passed, "total": len(first), "rate": round(passed * 100 / len(first), 1) if first else None, "daily": first_daily},
        "cost_per_ticket": {
            "unit": "percent_of_observed_model_runtime", "completed_tickets": len(completed),
            "total_model_seconds": round(sum(by_model.values()) / divisor, 1) if completed else None,
            "by_model_seconds": {model: round(seconds / divisor, 1) for model, seconds in sorted(by_model.items())} if completed else {},
            "by_provider_percent": provider_percent, "daily": cost_daily,
        },
    }


def collect(config_dir: Path, state_dir: Path, health_path: Path, now: float) -> tuple[dict[str, Any], dict[str, Any], dict[str, Any]]:
    agents = []
    feed_agents = []
    all_runs: list[dict[str, Any]] = []
    all_outcomes: list[dict[str, Any]] = []
    for conf_path in sorted(config_dir.glob("*.conf")):
        config = parse_env(conf_path)
        slug = config.get("AGENT_SLUG") or conf_path.stem
        role = role_of(config, slug)
        agent_id = config.get("AGENT_ID")
        if role is None or not agent_id or not IDENTITY.fullmatch(slug) or not IDENTITY.fullmatch(agent_id):
            continue
        command = config.get("MODEL_CLI", "")
        model = model_name(command)
        log_phase, runs, outcomes, log_at = parse_log(state_dir / f"{slug}.log", model, now)
        for row in runs:
            row["provider"] = provider_of(row["model"], command)
        all_runs.extend(runs)
        all_outcomes.extend(outcomes)
        lock = read_json(state_dir / f"{slug}.lock")
        current = ticket_from_lock(lock)
        lock_at = parse_time(lock.get("started_at"))
        blocked = read_json(state_dir / f"{slug}.blocked")
        if current:
            phase = "qa" if role == "qa" else "recovering" if role == "manager" else "working"
            observed = lock_at or log_at or now
        elif blocked.get("ticket"):
            phase, observed = "blocked", parse_time(blocked.get("since")) or log_at or now
        else:
            phase, observed = log_phase, log_at or now
        agents.append({
            "agent_id": agent_id, "slug": slug, "role": role, "current_ticket": current,
            "obligations": [current] if current else [], "execution": {"phase": phase, "observed_at": observed},
            "progress": {"state": "unknown"}, "incident_ids": [],
        })
        cutoff = now - 7 * 86400
        recent_outcomes = [row for row in outcomes if row["at"] >= cutoff]
        passes = sum(row["outcome"] == "done" for row in recent_outcomes)
        failures = sum(row["outcome"] == "returned" for row in recent_outcomes)
        last_run = runs[-1] if runs else None
        feed_agents.append({
            "id": agent_id, "slug": slug, "name": config.get("AGENT_NAME") or slug,
            "board": config.get("BOARD_ID"), "provider": provider_of(model, command), "model": model,
            "repository": config.get("PR_REPO"), "timerActive": None, "lastTick": None,
            "lastRun": ({"ticket": last_run["ticket"], "startedAt": iso(last_run["started_at"]),
                         "endedAt": iso(last_run["ended_at"]) if last_run["ended_at"] else None,
                         "result": "running" if last_run["ended_at"] is None and phase in {"working", "qa", "recovering"} else last_run["result"],
                         "exitCode": 0 if last_run["result"] == "succeeded" else None,
                         "rung": {"cursor": "Grok", "claude": "Claude", "codex": "Codex"}.get(provider_of(last_run["model"], command), "Unknown")}
                        if last_run else None),
            "ticketsPickedToday": len({row["ticket"] for row in runs if dt.datetime.fromtimestamp(row["started_at"], dt.timezone.utc).date() == dt.datetime.fromtimestamp(now, dt.timezone.utc).date()}),
            "failedAttemptsToday": sum(row["result"] == "failed" and dt.datetime.fromtimestamp(row["started_at"], dt.timezone.utc).date() == dt.datetime.fromtimestamp(now, dt.timezone.utc).date() for row in runs),
            "prsMergedToday": None, "mergedPullRequests": [], "qaPassesToday": passes,
            "qaFailsToday": failures, "qaPassRate": round(passes * 100 / (passes + failures), 1) if passes + failures else None,
        })
    health = read_json(health_path)
    slugs = {agent["slug"] for agent in agents}
    incidents = incident_rows(health, slugs, now)
    for agent in agents:
        agent["incident_ids"] = [row["id"] for row in incidents if row["affected_agent_slug"] == agent["slug"] or row["owner"] == agent["slug"]]
    complete = bool(agents) and bool(health)
    supervisor_state = "needs_attention" if incidents else "observing"
    source = lambda state: {"checked_at": now, "state": state, "complete": complete}
    snapshot = {
        "schema_version": 1, "project_key": "hypertask", "generation": now, "collected_at": now,
        "complete": complete,
        "sources": {"metadata": source("observed"), "progress": source("observed"), "supervisor": source(supervisor_state)},
        "agents": agents, "incidents": incidents,
    }
    metrics = calculate_metrics(all_runs, all_outcomes, now)
    live_daily = metrics["live_tickets"]["daily"]
    live_count = metrics["live_tickets"]["count"]
    cost = metrics["cost_per_ticket"]
    first_pass = metrics["first_pass"]
    board_health = {
        "score": health.get("score"), "band": health.get("band"), "updatedAt": health.get("at"),
        "line": health.get("line"), "top_column": health.get("top_column"), "top_count": health.get("top_count"),
        "violations": health.get("violations", []), "stale": parse_time(health.get("at")) is None or now - (parse_time(health.get("at")) or 0) > 1200,
    } if health else None
    feed = {
        "schemaVersion": 4, "generatedAt": iso(now),
        "kpi": {
            "repository": None, "base": None, "today": live_daily[-1]["date"], "measuredAt": iso(now),
            "unavailableReasons": {"liveTickets": None, "costPerLiveTicket": None, "firstPass": None,
                                     "oldestRedPr": "open pull-request checks are not part of the runner snapshot"},
            "liveTickets": {"today": {"agents": live_daily[-1]["agents"], "all": live_daily[-1]["all"]},
                            "average7d": {"agents": round(sum(row["agents"] for row in live_daily) / 7, 1),
                                          "all": round(sum(row["all"] for row in live_daily) / 7, 1)}, "daily": live_daily},
            "costPerLiveTicket": {"cursor": cost["by_provider_percent"].get("cursor"),
                                  "claude": cost["by_provider_percent"].get("claude"),
                                  "codex": cost["by_provider_percent"].get("codex"), "daily": cost["daily"]},
            "firstPass": {"rate": first_pass["rate"], "passed": first_pass["passed"], "total": first_pass["total"],
                          "method": "first-qa-outcome-done-vs-returned", "daily": first_pass["daily"]},
            "oldestRedPr": None,
        },
        "health": {"board": board_health, "cursor": None, "claudeWeekly": None, "codexWeekly": None},
        "agents": feed_agents, "trouble": {"escalations": None, "urgentNotStarted": None,
                                             "valentinReview": None, "redPullRequests": None},
        "attributionNote": "Live tickets are successful QA outcomes recorded by the runner.",
        "qaNote": "First pass is the first QA outcome in the last seven days: Done versus returned.",
        "sources": ["agent confs, runner locks and logs", "supervisor health violations"], "errors": [],
    }
    return snapshot, metrics, feed


def atomic_json(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_name(path.name + ".new")
    temporary.write_text(json.dumps(value, separators=(",", ":"), allow_nan=False) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    temporary.replace(path)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req: Any, fp: Any, code: int, msg: str, headers: Any, newurl: str) -> None:
        return None


def publish(document: dict[str, Any], credentials_path: Path, endpoint: str, route: str, limit: int) -> None:
    payload = json.dumps(document, separators=(",", ":"), allow_nan=False).encode()
    if len(payload) > limit:
        raise RuntimeError("snapshot exceeds the publishing limit")
    runtime_credentials = Path(os.environ.get("AGENT_RUNTIME_CONFIG", "~/.config/hypertask-agent-runtime.env")).expanduser()
    credentials = {**parse_env(credentials_path), **parse_env(runtime_credentials), **os.environ}
    base = credentials.get("HYPERTASK_APP_BASE") or endpoint
    suffix = "?project=hypertask" if route == "/api/factory-status" else ""
    url = urllib.parse.urljoin(base.rstrip("/") + "/", route.lstrip("/")) + suffix
    parsed = urllib.parse.urlsplit(url)
    expected_query = "project=hypertask" if route == "/api/factory-status" else ""
    if (parsed.scheme != "https" or parsed.hostname != "hypertask.app" or parsed.username or parsed.password
            or parsed.fragment or parsed.path != route or parsed.query != expected_query):
        raise RuntimeError("publisher needs an HTTPS hypertask.app status endpoint")
    token = credentials.get("AGENT_RUNTIME_TOKEN") or credentials.get("HYPERTASK_APP_SHARE_TOKEN")
    client_id = credentials.get("HYPERTASK_APP_CF_CLIENT_ID") or credentials.get("CF_ACCESS_CLIENT_ID")
    client_secret = credentials.get("HYPERTASK_APP_CF_CLIENT_SECRET") or credentials.get("CF_ACCESS_CLIENT_SECRET")
    if not all(isinstance(value, str) and value and not any(ord(char) < 32 for char in value) for value in (token, client_id, client_secret)):
        raise RuntimeError("publisher credentials are missing or invalid")
    request = urllib.request.Request(url, data=payload, method="PUT", headers={
        "User-Agent": "hypertask-agent-status/1", "Content-Type": "application/json",
        "Authorization": f"Bearer {token}", "CF-Access-Client-Id": client_id, "CF-Access-Client-Secret": client_secret,
    })
    try:
        with urllib.request.build_opener(NoRedirect()).open(request, timeout=15) as response:
            result = json.loads(response.read(4097))
            if not 200 <= response.status < 300 or not isinstance(result, dict) or result.get("ok") is not True:
                raise RuntimeError("publication was not acknowledged")
    except urllib.error.HTTPError as error:
        raise RuntimeError(f"publication returned HTTP {error.code}") from None
    except (urllib.error.URLError, OSError, ValueError):
        raise RuntimeError("publication failed") from None


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("collect", "publish"), nargs="?", default="collect")
    parser.add_argument("--config-dir", type=Path, default=Path(os.environ.get("AGENT_CONFIG_DIR", "~/.config/hypertask-agents")).expanduser())
    parser.add_argument("--state-dir", type=Path, default=Path(os.environ.get("AGENT_POLL_STATE_DIR", "~/.local/state/agent-board-poll")).expanduser())
    parser.add_argument("--health", type=Path, default=Path(os.environ.get("AGENT_SUPERVISOR_HEALTH", "~/.local/state/ht-supervisor/health.json")).expanduser())
    parser.add_argument("--output", type=Path)
    parser.add_argument("--now", type=float)
    args = parser.parse_args()
    now = args.now if args.now is not None else dt.datetime.now(dt.timezone.utc).timestamp()
    snapshot, metrics, feed = collect(args.config_dir, args.state_dir, args.health, now)
    output = args.output or args.state_dir / "factory-status.json"
    if args.command == "collect":
        if args.output:
            atomic_json(output, snapshot)
            atomic_json(args.state_dir / "agent-status-metrics.json", metrics)
            atomic_json(args.state_dir / "agent-feed.json", feed)
        else:
            print(json.dumps(snapshot, separators=(",", ":"), allow_nan=False))
        return 0
    atomic_json(output, snapshot)
    atomic_json(args.state_dir / "agent-status-metrics.json", metrics)
    atomic_json(args.state_dir / "agent-feed.json", feed)
    credentials = Path(os.environ.get("HYPERTASK_APP_CREDENTIALS", "~/.config/hypertask-app/credentials.env")).expanduser()
    publish(snapshot, credentials, "https://hypertask.app", "/api/factory-status", MAX_BYTES)
    publish(feed, credentials, "https://hypertask.app", "/api/agent-feed", 512_000)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except RuntimeError as error:
        print(f"ERROR: {error}. Do this next: check the agent-status log and publisher configuration", file=sys.stderr)
        raise SystemExit(1)
