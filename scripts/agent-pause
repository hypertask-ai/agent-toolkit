#!/usr/bin/env bash
# Pause or resume an agent without changing its timer or webhook registration.
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
CORE_ROOT="$(dirname "$(dirname "$SELF")")"
# shellcheck disable=SC1091
. "$CORE_ROOT/scripts/lib/core.sh"

resume=no
if [ "${1:-}" = "--resume" ]; then resume=yes; shift; fi
slug="${1:-}"
[[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid agent slug" "pass an agent slug"
shift
reason=""
if [ "$resume" = yes ]; then
  [ "$#" -eq 0 ] || die "unexpected arguments" "run agent-resume <slug>"
else
  if [ "$#" -eq 2 ] && [ "$1" = "--reason" ]; then
    reason="$2"
  elif [ "$#" -ne 0 ]; then
    die "unexpected arguments" "run agent-pause <slug> [--reason \"text\"]"
  fi
  [[ "$reason" != *$'\n'* && "$reason" != *$'\r'* ]] || die "reason contains a newline" "use one line of text"
fi
conf="$(core_find_conf "$slug")" || die "no conf found for agent '$slug'" "check the slug"
python3 - "$conf" "$resume" "$reason" <<'PYEOF'
import datetime
import os
from pathlib import Path
import re
import shlex
import sys
import tempfile

path = Path(sys.argv[1])
resume = sys.argv[2] == "yes"
reason = sys.argv[3]
lines = [line for line in path.read_text().splitlines(keepends=True)
         if not re.match(r"^(PAUSED|PAUSED_REASON|PAUSED_AT)=", line)]
text = "".join(lines)
if not resume:
    if text and not text.endswith("\n"):
        text += "\n"
    now = datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")
    text += f'PAUSED="yes"\nPAUSED_REASON={shlex.quote(reason)}\nPAUSED_AT="{now}"\n'
with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, prefix=".pause-", delete=False) as tmp:
    tmp.write(text)
    os.chmod(tmp.name, path.stat().st_mode & 0o777)
    name = tmp.name
os.replace(name, path)
PYEOF
