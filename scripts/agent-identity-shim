#!/usr/bin/env python3
"""Create fail-closed CLI aliases for one agent process tree."""

import os
from pathlib import Path
import shlex
import shutil
import sys


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def main() -> None:
    if len(sys.argv) != 4:
        fail("usage: agent-identity-shim <slug> <token-file> <board-cli>")
    slug, token_name, board_name = sys.argv[1:]
    if not slug or any(character not in "abcdefghijklmnopqrstuvwxyz0123456789-" for character in slug):
        fail(f"invalid agent slug {slug!r}")

    token_file = Path(token_name).expanduser().resolve()
    board_cli = Path(board_name).expanduser().resolve()
    try:
        has_token = bool(token_file.read_text(encoding="utf-8").strip())
    except OSError:
        has_token = False
    if not has_token:
        fail(f"no agent token for {slug}")
    if not os.access(board_cli, os.X_OK):
        fail(f"agent board wrapper is not executable for {slug}: {board_cli}")

    original_path = os.environ.get("AGENT_ORIGINAL_PATH") or os.environ.get("PATH", "")
    state_root = Path(
        os.environ.get("AGENT_IDENTITY_SHIM_DIR")
        or Path(os.environ.get("XDG_RUNTIME_DIR") or os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
        / "agent-identity-shims"
    )
    shim_dir = state_root / slug
    shim_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    shim_dir.chmod(0o700)

    names = ["hypertask"]
    names.extend(name for name in ("ht", "htbot") if shutil.which(name, path=original_path))
    script = """#!/usr/bin/env bash
set -euo pipefail
TOKEN_FILE={token_file}
[ -r "$TOKEN_FILE" ] && grep -q '[^[:space:]]' "$TOKEN_FILE" || {{ echo {error} >&2; exit 1; }}
export PATH={original_path}
exec {board_cli} "$@"
""".format(
        token_file=shlex.quote(str(token_file)),
        error=shlex.quote(f"no agent token for {slug}"),
        original_path=shlex.quote(original_path),
        board_cli=shlex.quote(str(board_cli)),
    )
    for name in names:
        target = shim_dir / name
        temporary = shim_dir / f".{name}.new"
        temporary.write_text(script, encoding="utf-8")
        temporary.chmod(0o700)
        temporary.replace(target)
    for stale in {"hypertask", "ht", "htbot"} - set(names):
        (shim_dir / stale).unlink(missing_ok=True)

    gh = shutil.which("gh", path=original_path)
    if gh:
        repo_config = Path(__file__).resolve().parent.parent / "repos.allow"
        gh_script = """#!/usr/bin/env bash
set -euo pipefail
REAL_GH=__GH__
REPOS_ALLOW="${AGENT_REPOS_ALLOW:-__REPOS_ALLOW__}"
configured_labels() {
  REPO="$1" REPOS_ALLOW="$REPOS_ALLOW" python3 - <<'PYEOF'
import csv
import json
import os
from pathlib import Path

labels = []
path = Path(os.environ["REPOS_ALLOW"])
if path.is_file():
    with path.open(encoding="utf-8", newline="") as handle:
        for row in csv.reader(line for line in handle if line.strip() and not line.lstrip().startswith("#")):
            row = [value.strip() for value in row]
            if len(row) >= 6 and row[2].casefold() == os.environ["REPO"].casefold():
                labels = [label for label in row[5:] if label]
                break
print(json.dumps({"labels": labels}, separators=(",", ":")))
PYEOF
}
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "create" ]; then
  output="$("$REAL_GH" "$@")"
  created="$(OUTPUT="$output" python3 - <<'PYEOF'
import os
import re

match = re.search(r"https://github\\.com/([^/]+/[^/]+)/pull/([0-9]+)", os.environ["OUTPUT"])
if match:
    print(f"{match.group(1)}\\t{match.group(2)}")
PYEOF
)"
  if [ -n "$created" ]; then
    IFS=$'\t' read -r repo number <<< "$created"
    if [ -n "${AGENT_OPENED_PRS:-}" ] && [ -n "${AGENT_RUN_REF:-}" ]; then
      if ! OPENED_PRS="$AGENT_OPENED_PRS" REPO="$repo" NUMBER="$number" REF="$AGENT_RUN_REF" python3 - <<'PYEOF'
import fcntl
import os

path = os.environ["OPENED_PRS"]
repo = os.environ["REPO"]
number = os.environ["NUMBER"]
ref = os.environ["REF"]
with open(path, "a+", encoding="utf-8") as handle:
    fcntl.flock(handle, fcntl.LOCK_EX)
    handle.seek(0)
    recorded = any(
        fields[:2] == [repo, number]
        for fields in (line.rstrip("\\n").split("\\t") for line in handle)
        if len(fields) >= 2
    )
    if not recorded:
        handle.write(f"{repo}\\t{number}\\t{ref}\\n")
        handle.flush()
        os.fsync(handle.fileno())
PYEOF
      then
        printf 'pull request opened but ownership could not be recorded: %s\n' "$output" >&2
        exit 2
      fi
    fi
    payload="$(configured_labels "$repo")"
    if [ "$payload" != '{"labels":[]}' ]; then
      if ! printf '%s\n' "$payload" \
          | "$REAL_GH" api --method POST "repos/$repo/issues/$number/labels" --input - >/dev/null; then
        printf 'pull request opened but configured labels could not be applied: %s\n' "$output" >&2
        exit 2
      fi
    fi
  fi
  printf '%s\n' "$output"
  exit 0
fi
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "merge" ]; then
  auto=no
  disable_auto=no
  for arg in "$@"; do
    [ "$arg" != "--auto" ] || auto=yes
    [ "$arg" != "--disable-auto" ] || disable_auto=yes
  done
  if [ "$disable_auto" = yes ]; then
    exec "$REAL_GH" "$@"
  fi
  if [ "$auto" != yes ]; then
    echo "merge refused: runners never merge pull requests by hand" >&2
    exit 2
  fi
fi
check_pr_labels() {
  local target="$1" repo="$2" details state labels
  local view=("$REAL_GH" pr view)
  [ -z "$target" ] || view+=("$target")
  [ -z "$repo" ] || view+=(--repo "$repo")
  details="$("${view[@]}" --json state,labels --jq '.state, (.labels[].name)' 2>/dev/null)" || {
    echo "pull request change refused: state and labels could not be verified" >&2
    exit 2
  }
  state="$(printf '%s\n' "$details" | sed -n '1p')"
  labels="$(printf '%s\n' "$details" | sed '1d')"
  if [ "$state" = "OPEN" ] && printf '%s\n' "$labels" | grep -qix 'valentin-review'; then
    echo "pull request change refused: open PR label valentin-review is manager-only" >&2
    exit 2
  fi
}
if [ "${1:-}" = "api" ]; then
  method=GET
  explicit_method=no
  has_fields=no
  endpoint=""
  args=("$@")
  for ((i = 1; i < ${#args[@]}; i++)); do
    case "${args[$i]}" in
      -X|--method) method="${args[$((i + 1))]:-}"; explicit_method=yes; i=$((i + 1)) ;;
      -X*|--method=*) method="${args[$i]#*=}"; method="${method#-X}"; explicit_method=yes ;;
      -f|-F|--field|--raw-field) has_fields=yes; i=$((i + 1)) ;;
      -f*|-F*|--field=*|--raw-field=*) has_fields=yes ;;
      -H|--header|--hostname|--input|--cache) i=$((i + 1)) ;;
      -*) ;;
      *) [ -n "$endpoint" ] || endpoint="${args[$i]}" ;;
    esac
  done
  if [ "$explicit_method" = no ] && [ "$has_fields" = yes ]; then method=POST; fi
  if [ "${method^^}" != GET ]; then
    if [[ "$endpoint" =~ /pulls/[0-9]+/merge ]] \
       || printf '%s\n' "$*" | grep -qF 'mergePullRequest'; then
      echo "merge refused: runners never merge pull requests by hand" >&2
      exit 2
    fi
    if [ "$endpoint" = graphql ] && printf '%s\n' "$*" | grep -qF 'PullRequest'; then
      echo "pull request change refused: use a guarded gh pr command" >&2
      exit 2
    fi
    if [[ "$endpoint" =~ ^/?repos/([^/]+/[^/]+)/(pulls|issues)/([0-9]+) ]]; then
      check_pr_labels "${BASH_REMATCH[3]}" "${BASH_REMATCH[1]}"
    fi
  fi
fi
case "${1:-} ${2:-}" in
  "pr close"|"pr comment"|"pr edit"|"pr merge"|"pr ready"|"pr reopen"|"pr review")
    target=""
    repo=""
    args=("$@")
    for ((i = 2; i < ${#args[@]}; i++)); do
      case "${args[$i]}" in
        --repo|-R) repo="${args[$((i + 1))]:-}"; i=$((i + 1)) ;;
        --repo=*|-R=*) repo="${args[$i]#*=}" ;;
        -*) ;;
        *) [ -n "$target" ] || target="${args[$i]}" ;;
      esac
    done
    check_pr_labels "$target" "$repo"
    ;;
esac
exec "$REAL_GH" "$@"
""".replace("__GH__", shlex.quote(gh)).replace("__REPOS_ALLOW__", shlex.quote(str(repo_config)))
        target = shim_dir / "gh"
        temporary = shim_dir / ".gh.new"
        temporary.write_text(gh_script, encoding="utf-8")
        temporary.chmod(0o700)
        temporary.replace(target)
    else:
        (shim_dir / "gh").unlink(missing_ok=True)

    print(shim_dir)


if __name__ == "__main__":
    main()
